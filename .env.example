# Public site URL for canonical/OG tags (required in production; never use localhost)
SITE_URL=https://magister.cards

# Direct booking link for SPIEL Essen / partner meetings
PUBLIC_CALENDLY_URL=https://calendly.com/getakwa-info/magister-cards

# Port (Railway sets this automatically)
PORT=4321

# Postgres (Railway plugin) — preorders + Four Worlds leaderboard.
# Reference the Postgres service DATABASE_URL onto the web service.
DATABASE_URL=

# Optional overrides / file fallbacks without Postgres:
# PREORDERS_DATABASE_URL=
# PREORDERS_FILE=/data/preorders.json
# LEADERBOARD_FILE=/data/leaderboard.json
