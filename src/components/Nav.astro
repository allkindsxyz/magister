---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { BOOKING_URL } from '../lib/site';
import SpielLogo from './SpielLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const externalBooking = BOOKING_URL.startsWith('http');
---

<nav id="main-nav" aria-label={t('nav.aria_label')}>
  <a href={getLocalizedPath('/', lang)} class="nav-logo" aria-label="Magister Cards">
    <img
      class="nav-logo-img"
      src="/media/magister-logo.png"
      alt=""
      width="1024"
      height="520"
      decoding="async"
    />
  </a>

  <ul class="nav-links">
    <li><a href="#deck">{t('nav.deck')}</a></li>
    <li><a href="#worlds">{t('nav.worlds')}</a></li>
    <li><a href="#fifty-four">{t('nav.cards')}</a></li>
    <li><a href="#authors">{t('nav.authors')}</a></li>
    <li><a href="#partnership">{t('nav.next')}</a></li>
    <li>
      <a href="#spiel" class="nav-event" aria-label={t('nav.spiel_aria')}>
        <SpielLogo class="nav-spiel-logo" width={112} height={49} />
      </a>
    </li>
  </ul>

  <div class="nav-actions">
    <div class="language-switcher" aria-label={t('nav.language_label')}>
      <a
        href={getLocalizedPath('/', 'en')}
        class:list={['language-link', { active: lang === 'en' }]}
        aria-current={lang === 'en' ? 'page' : undefined}
      >EN</a>
      <a
        href={getLocalizedPath('/', 'ru')}
        class:list={['language-link', { active: lang === 'ru' }]}
        aria-current={lang === 'ru' ? 'page' : undefined}
      >RU</a>
    </div>
    <a
      href={BOOKING_URL}
      class="nav-book"
      target={externalBooking ? '_blank' : undefined}
      rel={externalBooking ? 'noopener noreferrer' : undefined}
    >
      {t('nav.book')}
    </a>
  </div>

  <button
    class="nav-toggle"
    id="nav-toggle"
    type="button"
    aria-label={t('nav.menu_open')}
    data-open-label={t('nav.menu_open')}
    data-close-label={t('nav.menu_close')}
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span>
    <span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner">
    <ul>
      <li><a href="#deck" class="mobile-link">{t('nav.deck')}</a></li>
      <li><a href="#worlds" class="mobile-link">{t('nav.worlds')}</a></li>
      <li><a href="#fifty-four" class="mobile-link">{t('nav.cards')}</a></li>
      <li><a href="#authors" class="mobile-link">{t('nav.authors')}</a></li>
      <li><a href="#partnership" class="mobile-link">{t('nav.next')}</a></li>
      <li>
        <a href="#spiel" class="mobile-link nav-event" aria-label={t('nav.spiel_aria')}>
          <SpielLogo class="nav-spiel-logo nav-spiel-logo--mobile" width={160} height={70} />
        </a>
      </li>
    </ul>

    <div class="mobile-menu-footer">
      <a
        href={BOOKING_URL}
        class="btn btn-accent mobile-book"
        target={externalBooking ? '_blank' : undefined}
        rel={externalBooking ? 'noopener noreferrer' : undefined}
      >
        {t('nav.book')}
      </a>
      <div class="language-switcher">
        <a href={getLocalizedPath('/', 'en')} class:list={['language-link', { active: lang === 'en' }]}>EN</a>
        <a href={getLocalizedPath('/', 'ru')} class:list={['language-link', { active: lang === 'ru' }]}>RU</a>
      </div>
    </div>
  </div>
</div>

<a
  href={BOOKING_URL}
  class="mobile-book-sticky"
  target={externalBooking ? '_blank' : undefined}
  rel={externalBooking ? 'noopener noreferrer' : undefined}
>
  {t('nav.book')}
</a>

<style>
  nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) auto minmax(15rem, 1fr);
    align-items: center;
    gap: 2rem;
    min-height: 72px;
    padding: 0.8rem var(--page-pad);
    border-bottom: 1px solid transparent;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  nav.scrolled {
    border-color: var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-logo {
    width: max-content;
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.5rem);
    list-style: none;
  }

  .nav-links a,
  .language-link {
    color: var(--muted);
    font: 500 0.66rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-links a:hover,
  .language-link:hover,
  .language-link.active {
    color: var(--accent);
  }

  .nav-links .nav-event {
    display: inline-flex;
    align-items: center;
    padding: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .nav-links .nav-event:hover {
    opacity: 0.78;
  }

  .nav-spiel-logo {
    flex: 0 0 auto;
    display: block;
    width: auto;
    height: 1.3rem;
  }

  .nav-spiel-logo--mobile {
    height: 2.35rem;
  }

  .mobile-link.nav-event {
    display: flex;
    align-items: center;
    padding-block: 0.5rem;
  }

  .mobile-menu .nav-spiel-logo--mobile {
    height: 2rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .language-switcher {
    display: flex;
    gap: 0.65rem;
  }

  .nav-book {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 0.65rem 1rem;
    background: var(--accent);
    color: var(--white);
    font: 600 0.65rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-book:hover {
    background: var(--accent-dark);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    position: absolute;
    width: 24px;
    height: 1px;
    background: var(--ink);
    transition: transform 180ms ease;
  }

  .nav-toggle span:first-child {
    transform: translateY(-4px);
  }

  .nav-toggle span:last-child {
    transform: translateY(4px);
  }

  .nav-toggle[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    padding: 6.5rem var(--page-pad) 2rem;
    background: var(--paper);
  }

  .mobile-book-sticky {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 80;
    display: none;
    max-width: min(18rem, calc(100svw - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1rem;
    text-align: center;
    white-space: normal;
    background: var(--accent);
    color: var(--white);
    box-shadow: 0 8px 24px rgba(23, 23, 20, 0.18);
    font: 600 0.66rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-menu-inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
  }

  .mobile-menu ul {
    list-style: none;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-link {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--display);
    font-size: clamp(2rem, 10vw, 3.5rem);
    line-height: 1;
    text-decoration: none;
  }

  .mobile-menu-footer {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
  }

  @media (max-width: 1100px) {
    nav {
      grid-template-columns: 1fr auto;
    }

    .nav-links,
    .nav-actions {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .mobile-book-sticky {
      display: inline-flex;
    }

    .mobile-menu.open + .mobile-book-sticky {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuLinks = menu ? Array.from(menu.querySelectorAll<HTMLElement>('a')) : [];

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      open ? toggle.dataset.closeLabel || 'Close menu' : toggle.dataset.openLabel || 'Open menu'
    );
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('menu-open', open);
    if (open) menuLinks[0]?.focus();
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menuLinks.forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') {
      setMenu(false);
      toggle.focus();
      return;
    }
    if (event.key !== 'Tab' || !menu) return;

    const focusable = [toggle, ...menuLinks].filter(Boolean) as HTMLElement[];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
