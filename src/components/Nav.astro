---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath, LOCALE_LINKS } from '../i18n/utils';
import { BOOKING_URL } from '../lib/site';
import SpielLogo from './SpielLogo.astro';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
  /** SPIEL-era homepage nav (old_landing). */
  legacy?: boolean;
}

const { lang, legacy = false } = Astro.props;
const t = useTranslations(lang);
const externalBooking = BOOKING_URL.startsWith('http');
const homePath = legacy ? '/old_landing/' : '/';
const home = getLocalizedPath(homePath, lang);
const partnersHref = getLocalizedPath('/partners/', lang);
const orderHref = getLocalizedPath('/artifacts/deck', lang);
const spielHref = legacy ? `${home}#spiel` : partnersHref;
const primaryCtaHref = legacy ? BOOKING_URL : orderHref;
const primaryCtaLabel = legacy ? t('nav.book') : t('nav.order');
const primaryCtaExternal = legacy && externalBooking;
---

<nav id="main-nav" class:list={{ 'nav--solid': !legacy }} aria-label={t('nav.aria_label')}>
  <a href={`${home}#deck`} class="nav-logo" aria-label="Magister Cards">
    <MagisterLogo class="nav-logo-img" />
  </a>

  <ul class="nav-links">
    {
      legacy ? (
        <>
          <li><a href={`${home}#worlds`}>{t('nav.worlds')}</a></li>
          <li><a href={`${home}#fifty-four`}>{t('nav.cards')}</a></li>
          <li><a href={`${home}#play`}>{t('nav.play')}</a></li>
          <li><a href={`${home}#artifacts`}>{t('nav.next')}</a></li>
          <li><a href={`${home}#authors`}>{t('nav.authors')}</a></li>
          <li>
            <a href={spielHref} class="nav-event" aria-label={t('nav.spiel_aria')}>
              <SpielLogo class="nav-spiel-logo" width={112} height={49} />
            </a>
          </li>
        </>
      ) : (
        <>
          <li><a href={`${home}#worlds`}>{t('nav.worlds')}</a></li>
          <li><a href={`${home}#fifty-four`}>{t('nav.cards')}</a></li>
          <li><a href={`${home}#play`}>{t('nav.play')}</a></li>
          <li><a href={`${home}#artifacts`}>{t('nav.shop')}</a></li>
          <li><a href={`${home}#authors`}>{t('nav.authors')}</a></li>
          <li><a href={partnersHref}>{t('nav.partners')}</a></li>
        </>
      )
    }
  </ul>

  <div class="nav-actions">
    <div class="language-switcher" aria-label={t('nav.language_label')}>
      {LOCALE_LINKS.map(({ code, label }) => (
        <a
          href={getLocalizedPath(homePath, code)}
          class:list={['language-link', { active: lang === code }]}
          aria-current={lang === code ? 'page' : undefined}
          lang={code === 'zh' ? 'zh-Hans' : code}
        >
          {label}
        </a>
      ))}
    </div>
    {
      legacy ? (
        <a
          href={primaryCtaHref}
          class="nav-book"
          aria-label={t('nav.book_aria')}
          target={primaryCtaExternal ? '_blank' : undefined}
          rel={primaryCtaExternal ? 'noopener noreferrer' : undefined}
        >
          {primaryCtaLabel}
        </a>
      ) : (
        <a href={orderHref} class="nav-cart" aria-label={t('nav.cart_aria')}>
          <svg class="nav-cart__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M7 4h-2l-1 2h2.1l2.4 9.2a1.5 1.5 0 0 0 1.5 1.1h7.3a1.5 1.5 0 0 0 1.45-1.1L21 8H8.2l-.35-1.35A1.5 1.5 0 0 0 6.4 5.5H7V4Zm3.25 14.25a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
            />
          </svg>
        </a>
      )
    }
  </div>

  <div class="nav-mobile-tools">
    <div class="language-switcher language-switcher--bar" aria-label={t('nav.language_label')}>
      {LOCALE_LINKS.map(({ code, label }) => (
        <a
          href={getLocalizedPath(homePath, code)}
          class:list={['language-link', { active: lang === code }]}
          aria-current={lang === code ? 'page' : undefined}
          lang={code === 'zh' ? 'zh-Hans' : code}
        >
          {label}
        </a>
      ))}
    </div>
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label={t('nav.menu_open')}
      data-open-label={t('nav.menu_open')}
      data-close-label={t('nav.menu_close')}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner">
    <ul>
      {
        legacy ? (
          <>
            <li><a href={`${home}#worlds`} class="mobile-link">{t('nav.worlds')}</a></li>
            <li><a href={`${home}#fifty-four`} class="mobile-link">{t('nav.cards')}</a></li>
            <li><a href={`${home}#play`} class="mobile-link">{t('nav.play')}</a></li>
            <li><a href={`${home}#artifacts`} class="mobile-link">{t('nav.next')}</a></li>
            <li><a href={`${home}#authors`} class="mobile-link">{t('nav.authors')}</a></li>
            <li>
              <a href={spielHref} class="mobile-link nav-event" aria-label={t('nav.spiel_aria')}>
                <SpielLogo class="nav-spiel-logo nav-spiel-logo--mobile" width={160} height={70} />
              </a>
            </li>
          </>
        ) : (
          <>
            <li><a href={`${home}#worlds`} class="mobile-link">{t('nav.worlds')}</a></li>
            <li><a href={`${home}#fifty-four`} class="mobile-link">{t('nav.cards')}</a></li>
            <li><a href={`${home}#play`} class="mobile-link">{t('nav.play')}</a></li>
            <li><a href={`${home}#artifacts`} class="mobile-link">{t('nav.shop')}</a></li>
            <li><a href={`${home}#authors`} class="mobile-link">{t('nav.authors')}</a></li>
            <li><a href={partnersHref} class="mobile-link">{t('nav.partners')}</a></li>
          </>
        )
      }
    </ul>

    <div class="mobile-menu-footer">
      {
        legacy ? (
          <a
            href={primaryCtaHref}
            class="btn btn-accent mobile-book"
            aria-label={t('nav.book_aria')}
            target={primaryCtaExternal ? '_blank' : undefined}
            rel={primaryCtaExternal ? 'noopener noreferrer' : undefined}
          >
            {primaryCtaLabel}
          </a>
        ) : (
          <a href={orderHref} class="btn btn-accent mobile-cart" aria-label={t('nav.cart_aria')}>
            <svg class="nav-cart__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M7 4h-2l-1 2h2.1l2.4 9.2a1.5 1.5 0 0 0 1.5 1.1h7.3a1.5 1.5 0 0 0 1.45-1.1L21 8H8.2l-.35-1.35A1.5 1.5 0 0 0 6.4 5.5H7V4Zm3.25 14.25a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
              />
            </svg>
            <span>{t('nav.order')}</span>
          </a>
        )
      }
    </div>
  </div>
</div>

{
  legacy ? (
    <a
      href={BOOKING_URL}
      class="mobile-book-sticky"
      target={externalBooking ? '_blank' : undefined}
      rel={externalBooking ? 'noopener noreferrer' : undefined}
    >
      {t('nav.book')}
    </a>
  ) : (
    <a href={orderHref} class="mobile-book-sticky mobile-cart-sticky" aria-label={t('nav.cart_aria')}>
      <svg class="nav-cart__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M7 4h-2l-1 2h2.1l2.4 9.2a1.5 1.5 0 0 0 1.5 1.1h7.3a1.5 1.5 0 0 0 1.45-1.1L21 8H8.2l-.35-1.35A1.5 1.5 0 0 0 6.4 5.5H7V4Zm3.25 14.25a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
        />
      </svg>
    </a>
  )
}

<style>
  nav {
    --nav-mark-height: 3.0625rem;
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.85fr) minmax(0, 1.6fr) minmax(10rem, 0.9fr);
    align-items: center;
    gap: 0.85rem;
    min-height: 72px;
    padding: 0.8rem var(--page-pad);
    border-bottom: 1px solid transparent;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  nav.scrolled {
    border-color: var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  nav.nav--solid {
    border-color: color-mix(in srgb, var(--line) 70%, transparent);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-logo {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
    align-self: center;
    min-height: var(--nav-mark-height);
    padding-block: 0.15rem;
    line-height: 0;
    text-decoration: none;
  }

  .nav-logo :global(.magister-logo),
  .nav-logo :global(.nav-logo-img) {
    display: block;
    width: auto;
    height: var(--nav-mark-height);
    max-width: 11rem;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.4rem, 1vw, 1rem);
    list-style: none;
  }

  .nav-links a,
  .language-link {
    color: var(--muted);
    font: 500 0.6rem/1 var(--sans);
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-links a:hover,
  .language-link:hover,
  .language-link.active {
    color: var(--accent);
  }

  .nav-links .nav-event {
    display: inline-flex;
    align-items: center;
    padding: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .nav-links .nav-event:hover {
    opacity: 0.78;
  }

  .nav-spiel-logo {
    flex: 0 0 auto;
    display: block;
    width: auto;
    height: var(--nav-mark-height);
  }

  .nav-spiel-logo--mobile {
    height: 2.35rem;
  }

  .mobile-link.nav-event {
    display: flex;
    align-items: center;
    padding-block: 0.5rem;
  }

  .mobile-menu .nav-spiel-logo--mobile {
    height: 2rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    min-width: 0;
  }

  .language-switcher {
    display: flex;
    flex-shrink: 0;
    gap: 0.45rem;
  }

  .nav-book,
  .nav-cart {
    display: inline-flex;
    flex-shrink: 0;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.85rem;
    background: var(--accent);
    color: var(--white);
    font: 600 0.65rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav-cart {
    width: 2.5rem;
    padding-inline: 0;
  }

  .nav-cart__icon {
    display: block;
  }

  .nav-book:hover,
  .nav-cart:hover {
    background: var(--accent-dark);
  }

  .mobile-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .mobile-cart-sticky {
    width: 2.85rem;
    min-width: 2.85rem;
    padding: 0.75rem;
  }

  .nav-mobile-tools {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    min-width: 0;
  }

  .language-switcher--bar {
    flex-shrink: 1;
    min-width: 0;
    gap: 0.35rem;
  }

  .language-switcher--bar .language-link {
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  .nav-toggle {
    display: none;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    position: absolute;
    width: 24px;
    height: 1px;
    background: var(--ink);
    transition: transform 180ms ease;
  }

  .nav-toggle span:first-child {
    transform: translateY(-4px);
  }

  .nav-toggle span:last-child {
    transform: translateY(4px);
  }

  .nav-toggle[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    padding: 6.5rem var(--page-pad) 2rem;
    background: var(--paper);
  }

  .mobile-book-sticky {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 80;
    display: none;
    max-width: min(18rem, calc(100svw - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1rem;
    text-align: center;
    white-space: normal;
    background: var(--accent);
    color: var(--white);
    box-shadow: 0 8px 24px rgba(23, 23, 20, 0.18);
    font: 600 0.66rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-menu-inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
  }

  .mobile-menu ul {
    list-style: none;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-link {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--display);
    font-size: clamp(2rem, 10vw, 3.5rem);
    line-height: 1;
    text-decoration: none;
  }

  .mobile-menu-footer {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
  }

  @media (max-width: 1100px) {
    nav {
      --nav-mark-height: 2.35rem;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .nav-mobile-tools {
      display: flex;
    }

    .nav-logo {
      max-width: calc(100vw - var(--page-pad) * 2 - 9.5rem);
    }

    .nav-logo :global(.magister-logo),
    .nav-logo :global(.nav-logo-img) {
      height: var(--nav-mark-height);
      max-width: min(9.5rem, 100%);
    }

    .nav-links,
    .nav-actions {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .mobile-book-sticky {
      display: inline-flex;
    }

    .mobile-menu.open + .mobile-book-sticky {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuLinks = menu ? Array.from(menu.querySelectorAll<HTMLElement>('a')) : [];

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      open ? toggle.dataset.closeLabel || 'Close menu' : toggle.dataset.openLabel || 'Open menu'
    );
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('menu-open', open);
    if (open) menuLinks[0]?.focus();
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menuLinks.forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') {
      setMenu(false);
      toggle.focus();
      return;
    }
    if (event.key !== 'Tab' || !menu) return;

    const barLangLinks = Array.from(
      document.querySelectorAll<HTMLElement>('.language-switcher--bar .language-link')
    );
    const focusable = [toggle, ...barLangLinks, ...menuLinks].filter(Boolean) as HTMLElement[];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
