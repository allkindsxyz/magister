---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  showMore?: boolean;
}

const { lang, showMore = true } = Astro.props;
const t = useTranslations(lang);
const fullStoryHref = getLocalizedPath('/authors/', lang);
---

<section class="authors-compact editorial-section" id="authors" aria-labelledby="authors-title">
  <div class="page-shell authors-compact__grid">
    <figure class="authors-compact__media reveal">
      <img
        src="/media/authors-together.jpg"
        alt={t('authors.preface_image_alt')}
        width="1024"
        height="682"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="authors-compact__copy reveal">
      <p class="section-label">{t('authors.label')}</p>
      <h2 class="section-title" id="authors-title">{t('authors.compact_title')}</h2>
      <p class="body-copy">{t('authors.compact_body')}</p>
      <blockquote class="authors-compact__quote">
        <p>{t('authors.compact_quote')}</p>
        <footer>{t('authors.compact_quote_author')}</footer>
      </blockquote>
      {showMore && (
        <a class="text-link" href={fullStoryHref}>{t('authors.compact_more')}</a>
      )}
    </div>
  </div>
</section>

<style>
  .authors-compact {
    background: var(--paper);
  }

  .authors-compact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .authors-compact__media {
    margin: 0;
  }

  .authors-compact__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .authors-compact__copy .section-title {
    margin-top: 0.35rem;
  }

  .authors-compact__copy .body-copy {
    margin-top: 1rem;
    max-width: 36rem;
  }

  .authors-compact__quote {
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
    max-width: 34rem;
  }

  .authors-compact__quote p {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .authors-compact__quote footer {
    margin-top: 0.5rem;
    color: var(--muted);
    font: 600 0.68rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .authors-compact__copy .text-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  @media (max-width: 800px) {
    .authors-compact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
