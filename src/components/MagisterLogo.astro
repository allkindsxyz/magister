---
interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { class: className, width = 112, height = 49 } = Astro.props;
---

<img
  src="/media/magister-logo.png"
  alt=""
  class:list={['magister-logo', className]}
  width={width}
  height={height}
  decoding="async"
/>

<style>
  .magister-logo {
    display: block;
    width: auto;
    height: var(--nav-mark-height, 3.0625rem);
    max-width: 11rem;
    object-fit: contain;
  }
</style>
