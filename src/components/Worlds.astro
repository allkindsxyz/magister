---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';
import Gallery from './Gallery.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const suitOrder = ['hearts', 'diamonds', 'clubs', 'spades'] as const;
type Suit = (typeof suitOrder)[number];

const suitSymbols: Record<Suit, string> = {
  hearts: '♥',
  diamonds: '♦',
  clubs: '♣',
  spades: '♠',
};

const fallbackImage: Record<Suit, string> = {
  hearts: '/media/pilgrims.webp',
  diamonds: '/media/bearer.webp',
  clubs: '/media/lady.webp',
  spades: '/media/merchant.webp',
};

const allCards = await getCollection('cards');

function exampleForSuit(suit: Suit): { src: string; caption: string | null } {
  const inSuit = allCards.filter((card) => card.data.suit === suit);
  if (inSuit.length === 0) {
    return { src: fallbackImage[suit], caption: null };
  }
  const pick = inSuit.find((card) => card.data.featured) ?? inSuit[0];
  return {
    src: pick.data.image,
    caption: pick.data.title[lang],
  };
}

const examples = Object.fromEntries(suitOrder.map((suit) => [suit, exampleForSuit(suit)])) as Record<
  Suit,
  { src: string; caption: string | null }
>;
---

<section class="worlds editorial-section" id="worlds" aria-labelledby="worlds-title">
  <div class="page-shell">
    <header class="worlds-header reveal">
      <p class="section-label">{t('worlds_section.label')}</p>
      <h2 class="section-title" id="worlds-title">{t('worlds_section.title')}</h2>
      <p class="worlds-lead">{t('worlds_section.lead')}</p>
    </header>

    <div class="worlds-grid">
      {suitOrder.map((suit, index) => {
        const example = examples[suit];
        const worldName = t(`worlds.${suit}.name`);
        const alt = example.caption ? `${worldName} — ${example.caption}` : worldName;
        return (
          <article class="world-card reveal" style={`--delay:${index * 70}ms`}>
            <div class="world-visual">
              <div class="world-frame">
                <img
                  src={example.src}
                  alt={alt}
                  width="280"
                  height="392"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {example.caption && <p class="world-caption">{example.caption}</p>}
            </div>
            <span class={`world-symbol world-symbol--${suit}`} aria-hidden="true">{suitSymbols[suit]}</span>
            <h3>{worldName}</h3>
            <p class="world-body">{t(`worlds.${suit}.blurb`)}</p>
          </article>
        );
      })}
    </div>

    <Gallery lang={lang} />
  </div>
</section>

<style>
  .worlds {
    background: var(--paper-deep);
  }

  .worlds-header {
    max-width: 44rem;
  }

  .worlds-header .section-title {
    max-width: none;
    margin-top: 1rem;
    white-space: nowrap;
    font-size: clamp(2.2rem, 4.6vw, 4.6rem);
    line-height: 1;
  }

  .worlds-lead {
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.75;
  }

  .worlds-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(3.5rem, 6vw, 6rem) 0 0;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .world-card {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'visual'
      'symbol'
      'title'
      'body';
    gap: 0.55rem 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--paper-deep);
    transition-delay: var(--delay);
  }

  .world-visual {
    grid-area: visual;
    justify-self: center;
    width: min(100%, 11rem);
  }

  .world-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--white);
  }

  .world-frame img {
    width: 100%;
    aspect-ratio: 5 / 7;
    object-fit: contain;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .world-card:hover .world-frame img {
    transform: translateY(-0.2rem);
  }

  .world-caption {
    margin-top: 0.65rem;
    color: var(--muted);
    font: 600 0.58rem/1.45 var(--sans);
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .world-symbol {
    grid-area: symbol;
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 1;
  }

  .world-symbol--hearts,
  .world-symbol--diamonds {
    color: var(--accent);
  }

  .world-symbol--spades,
  .world-symbol--clubs {
    color: var(--ink);
  }

  .world-card h3 {
    grid-area: title;
    font-family: var(--display);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .world-body {
    grid-area: body;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (min-width: 781px) {
    .world-card {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'visual symbol'
        'visual title'
        'visual body';
      align-items: start;
    }

    .world-visual {
      width: auto;
      justify-self: stretch;
    }

    .world-caption {
      text-align: left;
    }
  }

  @media (max-width: 780px) {
    .worlds-grid {
      grid-template-columns: 1fr;
    }

    .worlds-header .section-title {
      font-size: clamp(1.7rem, 7.2vw, 2.6rem);
    }
  }
</style>
