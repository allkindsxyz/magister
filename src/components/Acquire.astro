---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contents = [
  t('physical.item_cards'),
  t('physical.item_art'),
  t('physical.item_stories'),
  t('physical.item_packaging'),
  t('physical.item_print'),
];
---

<section class="physical editorial-section" id="edition" aria-labelledby="physical-title">
  <div class="page-shell physical-grid">
    <header class="physical-heading reveal">
      <p class="section-label">{t('physical.label')}</p>
      <h2 class="section-title" id="physical-title">{t('physical.title')}</h2>
    </header>

    <div class="physical-copy reveal">
      <p class="lead">{t('physical.lead')}</p>
      <p class="body-copy">{t('physical.body')}</p>
      <ul>
        {contents.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="edition-image edition-image--closed reveal">
      <img
        src="/media/collector-box.webp"
        alt={t('physical.closed_alt')}
        width="682"
        height="1024"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{t('physical.closed_caption')}</figcaption>
    </figure>

    <figure class="edition-image edition-image--open reveal">
      <img
        src="/media/box-open.webp"
        alt={t('physical.open_alt')}
        width="682"
        height="1024"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{t('physical.open_caption')}</figcaption>
    </figure>

    <p class="physical-note reveal">{t('physical.note')}</p>
  </div>
</section>

<style>
  .physical {
    background: var(--white);
  }

  .physical-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 4rem 1.5rem;
  }

  .physical-heading {
    grid-column: 1 / 7;
  }

  .physical-heading .section-title {
    margin-top: 1.75rem;
  }

  .physical-copy {
    grid-column: 8 / 13;
    padding-top: 3.2rem;
  }

  .physical-copy .body-copy {
    margin-top: 1.5rem;
  }

  .physical-copy ul {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .physical-copy li {
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font: 500 0.69rem/1.4 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .edition-image {
    grid-row: 2;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .edition-image--closed {
    grid-column: 1 / 7;
  }

  .edition-image--open {
    grid-column: 7 / 10;
    align-self: end;
    padding-bottom: 0;
  }

  .edition-image img {
    width: auto;
    max-width: 100%;
    max-height: 650px;
    object-fit: contain;
    object-position: left bottom;
    background: var(--paper);
  }

  .edition-image figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font: 500 0.62rem/1.4 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .physical-note {
    grid-column: 10 / 13;
    grid-row: 2;
    align-self: end;
    margin-bottom: 2rem;
    font-family: var(--display);
    font-size: clamp(1.75rem, 3.3vw, 3.5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  @media (max-width: 800px) {
    .physical-heading,
    .physical-copy,
    .edition-image--closed,
    .edition-image--open,
    .physical-note {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .physical-copy {
      padding-top: 0;
    }

    .edition-image {
      margin-top: 2rem;
    }

    .edition-image--open {
      width: 72%;
      margin-left: auto;
      padding-bottom: 0;
    }

    .physical-note {
      width: 82%;
      margin-top: 1rem;
    }
  }
</style>
