          decoding="async"
        />
      </figure>
      <div class="proto-sku__deck reveal">
        <p class="lead">54 original artworks. Four worlds. One deck.</p>
        <p class="body-copy">
          Play it as cards. Read it as myth. Gift the card that belongs to someone’s birthday —
          with a story that stays.
        </p>
        <ul class="proto-sku__points">
          <li>Regular &amp; XL sizes planned for first printing</li>
          <li>EU &amp; US shipping</li>
          <li>Each card: painting + lore</li>
        </ul>
        <a class="btn btn-accent" href="#waitlist">Join the first printing list</a>
      </div>
    </div>

    <div class="proto-sku__gift reveal">
      <div class="proto-sku__gift-copy">
        <p class="section-label">Personal story</p>
        <h3 class="proto-sku__gift-title">A Card. A Story. A Memory.</h3>
        <p class="body-copy">
          Apparel and prints carry a unique QR — a private or public message tied to the card you
          chose. The deck comes first; personalization is how Magister stays with someone.
        </p>
        <a class="text-link" href="/en/artifacts/apparel">See the merch prototype →</a>
      </div>
      <img
        class="proto-sku__gift-img"
        src="/media/merch-apparel-hero.jpg"
        alt="Magister hoodie with personal digital story"
        width="704"
        height="1024"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 6. Games teaser -->
  <section class="proto-play editorial-section" id="play" aria-labelledby="play-title">
    <div class="page-shell proto-play__inner reveal">
      <p class="section-label">Already playable</p>
      <h2 class="section-title" id="play-title">Enter the world online</h2>
      <p class="body-copy">
        Learn the four worlds, dig into card lore, and try Card of Destiny — live on the current
