---
import { getCollection } from 'astro:content';
import MagisterLogo from '../MagisterLogo.astro';
import { pickLocalized } from '../../i18n/utils';
import { BOOKING_URL, CONTACT_EMAIL } from '../../lib/site';

const lang = 'en' as const;

const allCards = await getCollection('cards');
const faceCards = allCards
  .filter((c) => !c.data.back && c.data.suit && c.data.value)
  .map((c) => ({
    id: c.data.id as string,
    suit: c.data.suit as string,
    value: c.data.value as string,
    title: pickLocalized(c.data.title, lang),
    summary: pickLocalized(c.data.summary, lang),
    image: c.data.image as string,
    featured: Boolean(c.data.featured),
  }));

const byId = Object.fromEntries(faceCards.map((c) => [c.id, c]));

const suitOrder = ['hearts', 'diamonds', 'clubs', 'spades'] as const;
const worlds = {
  hearts: {
    name: 'Olympic Gods',
    blurb: 'Desire, metamorphosis, oracle and flame.',
    example: 'queen-hearts',
  },
  diamonds: {
    name: 'Bearers of Secrets',
    blurb: 'Alchemy, hidden orders, knowledge that travels in whispers.',
    example: 'ace-diamonds',
  },
  clubs: {
    name: 'Templars',
    blurb: 'Devotion, intrigue, and the long shadow of the order.',
    example: 'queen-clubs',
  },
  spades: {
    name: 'Modern Myths',
    blurb: 'Public faces reframed as lasting emblems.',
    example: 'jack-spades',
  },
} as const;

const suitSymbols: Record<(typeof suitOrder)[number], string> = {
  hearts: '♥',
  diamonds: '♦',
  clubs: '♣',
  spades: '♠',
};

const galleryStrip = [
  'queen-hearts',
  'ace-diamonds',
  'queen-clubs',
  'jack-spades',
  'king-hearts',
  'ace-spades',
  '10-clubs',
  'ace-hearts',
]
  .map((id) => byId[id])
  .filter(Boolean);

/** Ordered loop for hero crossfade — full face deck. */
const heroImages = faceCards.map((c) => c.image);
const heroFirst = heroImages[0] ?? '/media/selected-work.webp';

const months = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

const cardsPayload = JSON.stringify(
  Object.fromEntries(
    faceCards.map((c) => [
      c.id,
      { id: c.id, title: c.title, summary: c.summary, image: c.image, suit: c.suit, value: c.value },
    ]),
  ),
).replace(/</g, '\\u003c');

const jokerPair = {
  ace: byId['ace-hearts'],
  king: byId['king-spades'],
};
---

<div class="proto-banner" role="status">
  <div class="page-shell proto-banner__inner">
    <span>Prototype landing — demand-first</span>
    <div class="proto-banner__links">
      <button type="button" class="proto-banner__reset" id="proto-reset-sheet">
        Reset destiny prompt
      </button>
      <a href="/en/">← Current live site</a>
    </div>
  </div>
</div>

<nav class="proto-nav" aria-label="Prototype navigation">
  <div class="page-shell proto-nav__inner">
    <a href="#deck" class="proto-nav__logo" aria-label="Magister Cards">
      <MagisterLogo class="proto-nav__mark" width={220} height={102} />
    </a>
    <div class="proto-nav__links">
      <a href="#birth">Your card</a>
      <a href="#worlds">Worlds</a>
      <a href="#deck-sku">The deck</a>
      <a href="#waitlist" class="proto-nav__cta">Join the list</a>
    </div>
  </div>
</nav>

<main id="main-content">
  <!-- 1. Hero: brand + one lead + one body + CTAs + full-bleed art -->
  <section class="proto-hero" id="deck" aria-labelledby="proto-hero-title">
    <div class="proto-hero__media" aria-hidden="true" data-hero-media>
      <img
        class="proto-hero__stage is-front is-in"
        data-hero-a
        src={heroFirst}
        alt=""
        width="1200"
        height="1680"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="proto-hero__stage"
        data-hero-b
        src={heroFirst}
        alt=""
        width="1200"
        height="1680"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="proto-hero__veil" aria-hidden="true"></div>
    <div class="page-shell proto-hero__copy">
      <p class="proto-hero__meta">54 paintings · 4 worlds · one card that may be yours</p>
      <h1 id="proto-hero-title" class="proto-hero__title" aria-label="Magister Cards">
        <span class="proto-hero__wordmark" aria-hidden="true">
          <MagisterLogo width={880} height={407} />
        </span>
      </h1>
      <p class="proto-hero__lead">
        An original myth deck — art you can play, gift, and read as a sign.
      </p>
      <p class="proto-hero__body">
        Each card is a finished painting with its own story. Find the card tied to your birth
        date — or choose one that stays with someone you love.
      </p>
      <div class="proto-hero__actions">
        <a class="btn btn-accent" href="#birth">Discover your birthday card</a>
        <a class="btn proto-btn-light" href="#waitlist">Join the first printing</a>
      </div>
    </div>
  </section>

  <!-- 2. Birth card lead magnet -->
  <section class="proto-birth editorial-section" id="birth" aria-labelledby="birth-title">
    <div class="page-shell proto-birth__grid">
      <header class="proto-birth__intro reveal">
        <p class="section-label">Your card</p>
        <h2 class="section-title" id="birth-title">One painting already belongs to you</h2>
        <p class="body-copy">
          Your birthday is tied to a single card in the Magister deck. Enter the day you were born —
          and see the artwork that has been waiting for you.
        </p>
      </header>

      <div class="proto-birth__panel reveal" data-birth-root>
        <form class="proto-birth__form" id="proto-birth-form">
          <label class="proto-field">
            <span>Month</span>
            <select name="month" id="proto-month" required>
              {
                months.map((name, i) => (
                  <option value={i + 1}>{name}</option>
