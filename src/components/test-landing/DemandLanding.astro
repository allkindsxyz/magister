  <!-- 9. Essen secondary -->
  <section class="proto-essen editorial-section" id="spiel" aria-labelledby="essen-title">
    <div class="page-shell proto-essen__inner reveal">
      <p class="section-label">Publishers &amp; partners</p>
      <h2 class="section-title" id="essen-title">SPIEL Essen 2026</h2>
