    <div class="proto-strip__rail" tabindex="0" aria-label="Sample cards from the deck">
      {
        galleryStrip.map((card) => (
          <figure class="proto-strip__card">
            <img src={card.image} alt={card.title} width="240" height="336" loading="lazy" />
            <figcaption>{card.title}</figcaption>
