        </p>
        <a class="text-link" href="/en/#authors">Full author story on live site →</a>
      </div>
    </div>
  </section>

  <!-- 8. Waitlist -->
  <section class="proto-wait editorial-section" id="waitlist" aria-labelledby="wait-title">
    <div class="page-shell proto-wait__inner reveal">
      <p class="section-label">First printing</p>
      <h2 class="section-title" id="wait-title">Get on the list</h2>
      <p class="body-copy">
        Early access to the first EU &amp; US shipping run. No spam — print news and launch only.
      </p>
      <form class="proto-wait__form" id="proto-wait-form">
        <label class="visually-hidden" for="proto-email">Email</label>
        <input
          id="proto-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
