    <div class="page-shell">
      <header class="proto-worlds__header reveal">
        <p class="section-label">Four worlds</p>
        <h2 class="section-title" id="worlds-title">One deck. Four mythic realms.</h2>
        <p class="body-copy">
          Fifty-four original paintings by Vasily Pochitsky — gods, secret-bearers, Templars, and
          modern myths — woven into a classic suit system.
        </p>
      </header>

      <div class="proto-worlds__grid">
        {
          suitOrder.map((suit, index) => {
            const world = worlds[suit];
            const card = byId[world.example];
            return (
              <article class="proto-world reveal" style={`--delay:${index * 60}ms`}>
                {card && (
                  <img
                    src={card.image}
                    alt={`${world.name} — ${card.title}`}
                    width="280"
                    height="392"
                    loading="lazy"
                    decoding="async"
