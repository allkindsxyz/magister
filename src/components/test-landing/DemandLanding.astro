      </div>
    </div>
  </section>

  <!-- 4. Gallery strip -->
  <section class="proto-strip editorial-section" id="gallery" aria-labelledby="strip-title">
    <div class="page-shell">
      <header class="proto-strip__header reveal">
        <p class="section-label">The collection</p>
        <h2 class="section-title" id="strip-title">Paintings first. Cards second.</h2>
        <p class="body-copy">
