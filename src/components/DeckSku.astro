---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { PRICES, formatPrice, deckProductJsonLd } from '../lib/pricing';
import { absoluteUrl, localizedAbsoluteUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const deckHref = getLocalizedPath('/artifacts/deck', lang);
const shopHref = `${getLocalizedPath('/', lang)}#artifacts`;

/** Physical card sizes drive relative on-screen scale of the two packs. */
const formats = [
  {
    key: 'xl',
    image: '/media/pack.webp',
    width: 1200,
    height: 800,
    widthMm: 70,
    heightMm: 120,
    name: t('deck_sku.xl_name'),
    purpose: t('deck_sku.xl_purpose'),
    spec: t('deck_sku.xl_spec'),
    price: formatPrice(PRICES.xl, lang),
    alt: t('deck_sku.image_alt'),
  },
  {
    key: 'standard',
    image: '/media/pack-standard.webp',
    width: 687,
    height: 1024,
    widthMm: 50,
    heightMm: 80,
    name: t('deck_sku.standard_name'),
    purpose: t('deck_sku.standard_purpose'),
    spec: t('deck_sku.standard_spec'),
    price: formatPrice(PRICES.standard, lang),
    alt: t('deck_sku.image_alt_standard'),
  },
];

const extraRows = [
  { label: t('deck_sku.price_set'), amount: PRICES.set },
  { label: t('deck_sku.price_two_xl'), amount: PRICES.two_xl },
];

const productJsonLd = deckProductJsonLd({
  url: localizedAbsoluteUrl(lang, '/artifacts/deck'),
  image: absoluteUrl('/media/pack.webp'),
  description: t('deck_sku.body'),
  xlName: t('deck_sku.price_xl'),
  standardName: t('deck_sku.price_standard'),
  setName: t('deck_sku.price_set'),
  twoXlName: t('deck_sku.price_two_xl'),
});
---

<section class="deck-sku editorial-section" id="deck-sku" aria-labelledby="deck-sku-title">
  <div class="page-shell deck-sku__grid">
    <div class="deck-sku__copy reveal">
      <h2 class="section-title" id="deck-sku-title">{t('deck_sku.title')}</h2>
      <p class="lead">{t('deck_sku.lead')}</p>
      <p class="body-copy">{t('deck_sku.body')}</p>

      <details class="deck-sku__more">
        <summary>{t('deck_sku.more_title')}</summary>
        <dl>
          {
            extraRows.map((row) => (
              <div class="deck-sku__row">
                <dt>{row.label}</dt>
                <dd>{formatPrice(row.amount, lang)}</dd>
              </div>
            ))
          }
        </dl>
        <p>{t('deck_sku.shipping')}</p>
        <p>{t('deck_sku.delivery')}</p>
      </details>

      <div class="deck-sku__actions">
        <a class="btn btn-accent" href={deckHref}>{t('deck_sku.cta')}</a>
        <a class="text-link" href={shopHref}>{t('deck_sku.shop_link')}</a>
      </div>
    </div>

    <ul class="deck-sku__formats reveal" aria-label={t('deck_sku.formats_aria')}>
      {
        formats.map((format) => (
          <li class="deck-format" style={`--w: ${format.widthMm}; --h: ${format.heightMm};`}>
            <img
              class="deck-format__pack"
              src={format.image}
              alt={format.alt}
              width={format.width}
              height={format.height}
              loading="lazy"
              decoding="async"
            />
            <p class="deck-format__name">
              {format.name}
              <span class="deck-format__purpose">{format.purpose}</span>
            </p>
            <p class="deck-format__spec">{format.spec}</p>
            <p class="deck-format__price">{format.price}</p>
          </li>
        ))
      }
    </ul>
  </div>
  <script type="application/ld+json" set:html={productJsonLd} />
</section>

<style>
  .deck-sku {
    background: var(--white);
  }

  .deck-sku__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .deck-sku__copy .section-title {
    margin-top: 0;
  }

  .deck-sku__more {
    margin: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .deck-sku__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    color: var(--ink);
    cursor: pointer;
    font: 600 0.7rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    list-style: none;
    text-transform: uppercase;
  }

  .deck-sku__more summary::-webkit-details-marker {
    display: none;
  }

  .deck-sku__more summary::after {
    content: '+';
    font: 400 1.2rem/1 var(--sans);
    transition: transform 180ms ease;
  }

  .deck-sku__more[open] summary::after {
    transform: rotate(45deg);
  }

  .deck-sku__more dl {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .deck-sku__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--line);
  }

  .deck-sku__row dd {
    margin: 0;
    font-family: var(--display);
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .deck-sku__more p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .deck-sku__more p:last-child {
    margin-bottom: 1rem;
  }

  .deck-sku__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .deck-sku__formats {
    /* One millimetre of card height → pack scale (XL taller than standard). */
    --mm: clamp(1.85px, 0.48vw, 2.55px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deck-format {
    flex: 0 1 auto;
    width: min(100%, calc(var(--h) * var(--mm) * 0.85));
  }

  .deck-format__pack {
    display: block;
    width: 100%;
    height: calc(var(--h) * var(--mm));
    object-fit: contain;
    object-position: bottom center;
    background: color-mix(in srgb, var(--paper) 55%, var(--white));
  }

  .deck-format__name {
    margin: 1rem 0 0;
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .deck-format__purpose {
    display: block;
    color: var(--muted);
    font-style: italic;
  }

  .deck-format__spec,
  .deck-format__price {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .deck-format__price {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .deck-sku__grid {
      grid-template-columns: 1fr;
    }

    .deck-sku__formats {
      justify-content: flex-start;
    }
  }
</style>
