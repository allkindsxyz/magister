---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { deckProductJsonLd } from '../lib/pricing';
import { absoluteUrl, localizedAbsoluteUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const deckHref = getLocalizedPath('/artifacts/deck', lang);
const shopHref = `${getLocalizedPath('/', lang)}#artifacts`;

/** Same XL shot as the shop card; standard is the product pack photo. */
const slides = [
  {
    key: 'xl',
    image: '/media/deck-lifestyle.jpg',
    width: 1024,
    height: 672,
    label: t('deck_sku.xl_name'),
    alt: t('deck_sku.image_alt'),
  },
  {
    key: 'standard',
    image: '/media/pack-standard.webp',
    width: 785,
    height: 1024,
    label: t('deck_sku.standard_name'),
    alt: t('deck_sku.image_alt_standard'),
  },
];

const productJsonLd = deckProductJsonLd({
  url: localizedAbsoluteUrl(lang, '/artifacts/deck'),
  image: absoluteUrl('/media/deck-lifestyle.jpg'),
  description: t('deck_sku.body'),
  xlName: t('deck_sku.price_xl'),
  standardName: t('deck_sku.price_standard'),
});
---

<section class="deck-sku editorial-section" id="deck-sku" aria-labelledby="deck-sku-title">
  <div class="page-shell deck-sku__grid">
    <div class="deck-sku__copy reveal">
      <h2 class="section-title" id="deck-sku-title">{t('deck_sku.title')}</h2>
      <p class="lead">{t('deck_sku.lead')}</p>
      <p class="body-copy">{t('deck_sku.body')}</p>

      <details class="deck-sku__more">
        <summary>{t('deck_sku.more_title')}</summary>
        <p>{t('deck_sku.shipping')}</p>
        <p>{t('deck_sku.delivery')}</p>
      </details>

      <div class="deck-sku__actions">
        <a class="btn btn-accent" href={deckHref}>{t('deck_sku.cta')}</a>
        <a class="text-link" href={shopHref}>{t('deck_sku.shop_link')}</a>
      </div>
    </div>

    <div class="deck-sku__media reveal" data-deck-gallery>
      <div
        class="deck-sku__track"
        data-deck-track
        tabindex="0"
        aria-roledescription="carousel"
        aria-label={t('deck_sku.formats_aria')}
      >
        {
          slides.map((slide, index) => (
            <figure class="deck-sku__slide" data-deck-slide={slide.key} aria-hidden={index === 0 ? 'false' : 'true'}>
              <img
                src={slide.image}
                alt={slide.alt}
                width={slide.width}
                height={slide.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
            </figure>
          ))
        }
      </div>

      <div class="deck-sku__dots" role="tablist" aria-label={t('deck_sku.formats_aria')}>
        {
          slides.map((slide, index) => (
            <button
              class:list={['deck-sku__dot', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={slide.label}
              data-deck-dot={index}
            />
          ))
        }
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={productJsonLd} />
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-deck-gallery]');
  const track = root?.querySelector<HTMLElement>('[data-deck-track]');
  if (!root || !track) {
    /* gallery missing */
  } else {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-deck-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-deck-dot]'));
    let active = 0;
    let frame = 0;

    const setActive = (index: number): void => {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      active = next;
      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', String(i !== next));
      });
      dots.forEach((dot, i) => {
        const on = i === next;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-selected', String(on));
      });
    };

    const goTo = (index: number, smooth = true): void => {
      const width = track.clientWidth;
      if (!width) return;
      track.scrollTo({ left: index * width, behavior: smooth ? 'smooth' : 'auto' });
      setActive(index);
    };

    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const width = track.clientWidth;
          if (!width) return;
          setActive(Math.round(track.scrollLeft / width));
        });
      },
      { passive: true },
    );

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.deckDot);
        if (Number.isFinite(index)) goTo(index);
      });
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(active + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(active - 1);
      }
    });

    if ('ResizeObserver' in window) {
      let lastWidth = track.clientWidth;
      new ResizeObserver(() => {
        if (track.clientWidth === lastWidth) return;
        lastWidth = track.clientWidth;
        goTo(active, false);
      }).observe(track);
    }
  }
</script>

<style>
  .deck-sku {
    background: var(--white);
  }

  .deck-sku__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .deck-sku__copy .section-title {
    margin-top: 0;
  }

  .deck-sku__more {
    margin: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .deck-sku__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    color: var(--ink);
    cursor: pointer;
    font: 600 0.7rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    list-style: none;
    text-transform: uppercase;
  }

  .deck-sku__more summary::-webkit-details-marker {
    display: none;
  }

  .deck-sku__more summary::after {
    content: '+';
    font: 400 1.2rem/1 var(--sans);
    transition: transform 180ms ease;
  }

  .deck-sku__more[open] summary::after {
    transform: rotate(45deg);
  }

  .deck-sku__more p {
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .deck-sku__more p:last-child {
    margin-bottom: 1rem;
  }

  .deck-sku__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .deck-sku__media {
    display: grid;
    gap: 0.85rem;
    width: min(100%, 24rem);
    justify-self: center;
  }

  .deck-sku__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    outline: none;
  }

  .deck-sku__track::-webkit-scrollbar {
    display: none;
  }

  .deck-sku__track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .deck-sku__slide {
    margin: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Match the shop card framing: same crop box for both slides. */
  .deck-sku__slide img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    height: auto;
    object-fit: cover;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  .deck-sku__dots {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
  }

  .deck-sku__dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    cursor: pointer;
  }

  .deck-sku__dot.is-active {
    background: var(--ink);
  }

  .deck-sku__dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 860px) {
    .deck-sku__grid {
      grid-template-columns: 1fr;
    }

    .deck-sku__media {
      width: min(100%, 22rem);
      justify-self: start;
    }
  }
</style>
