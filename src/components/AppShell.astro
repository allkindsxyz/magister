---
import type { Lang } from '../i18n/utils';
import { LOCALE_LINKS, getLocalizedPath } from '../i18n/utils';
import { appCopy, HUB_DETAIL_SEP, type HubDoorId } from '../i18n/appCopy';
import { gamesCopy } from '../i18n/gamesCopy';
import { formatPrice, PRICES } from '../lib/pricing';
import MagisterLogo from './MagisterLogo.astro';
import Gallery from './Gallery.astro';
import Games from './Games.astro';
import DeckGuide from './DeckGuide.astro';
import OnlineTable from './OnlineTable.astro';
import { onlineCopy } from '../i18n/onlineCopy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = appCopy[lang];
const onlineMenu = onlineCopy[lang];
const games = gamesCopy[lang];
const price = formatPrice(PRICES.standard, lang);
const shopHref = `${getLocalizedPath('/', lang)}?from=app#deck-sku`;
const siteHref = getLocalizedPath('/', lang);
const currentLang = LOCALE_LINKS.find((item) => item.code === lang) ?? LOCALE_LINKS[0];

const preload = [
  '/media/magister-logo.png',
  '/media/card-back.jpg',
  '/media/poster-four-worlds.gif',
  '/media/poster-initiation.gif',
  '/media/poster-ask-magister.webp',
  '/media/deck-lifestyle.jpg',
].join(',');

type Door = {
  id: HubDoorId;
  title: string;
  blurb: string;
  detail: string[];
  cta: string;
  kind?: 'prose';
  art?: string;
  artW?: number;
  artH?: number;
  lockedUntil?: 'worlds';
  soon?: boolean;
  fit?: 'cover' | 'contain';
};

const deckLink = `${getLocalizedPath('/', lang)}#deck`;

const hubOrder: HubDoorId[] = ['deck', 'cards', 'lore', 'learn', 'birthday', 'oracle', 'online', 'buy'];

const doorDefaults: Record<
  HubDoorId,
  Omit<Door, 'id' | 'title' | 'blurb' | 'detail' | 'cta'>
> = {
  deck: { kind: 'prose' },
  cards: { art: '/media/card-back.jpg', artW: 732, artH: 1024 },
  lore: {
    art: '/media/poster-initiation.gif',
    artW: 386,
    artH: 439,
    fit: 'cover',
    lockedUntil: 'worlds',
  },
  learn: {
    art: '/media/poster-four-worlds.gif',
    artW: 403,
    artH: 423,
    fit: 'cover',
  },
  birthday: { art: '/media/card-back.jpg', artW: 732, artH: 1024, lockedUntil: 'worlds' },
  oracle: { art: '/media/poster-ask-magister.webp', artW: 656, artH: 1024, lockedUntil: 'worlds' },
  online: { art: '/media/card-back.jpg', artW: 732, artH: 1024 },
  buy: { art: '/media/deck-lifestyle.jpg', artW: 1024, artH: 672, fit: 'cover' },
};

const doors: Door[] = hubOrder.map((id) => {
  const hub = copy.hub_doors[id];
  return {
    id,
    title: hub.title,
    blurb: hub.blurb,
    detail: hub.detail,
    cta: hub.cta,
    ...doorDefaults[id],
  };
});

const startIndex = 0;
---

<div class="mag-app" data-app data-preload={preload} data-deck-link={deckLink} data-shop-link={shopHref}>
  <div class="mag-app-boot" data-app-boot>
    <div class="mag-app-boot__mark">
      <MagisterLogo class="mag-app-boot__logo" level width={200} height={88} />
    </div>
    <p class="mag-app-boot__cue">{copy.boot_cue}</p>
  </div>

  <section class="mag-app-age" data-app-age hidden>
    <MagisterLogo class="mag-app-age__logo" level width={168} height={74} />
    <h1 class="mag-app-age__title">{copy.age_title}</h1>
    <p class="mag-app-age__lead">{copy.age_body}</p>
    <div class="mag-app-age__actions">
      <button class="mag-app-btn mag-app-btn--accent" type="button" data-app-action="age-yes">
        {copy.age_confirm}
      </button>
      <button class="mag-app-btn" type="button" data-app-action="age-no">
        {copy.age_deny}
      </button>
    </div>
  </section>

  <section class="mag-app-age mag-app-age--blocked" data-app-age-blocked hidden>
    <MagisterLogo class="mag-app-age__logo" level width={168} height={74} />
    <h1 class="mag-app-age__title">{copy.age_blocked}</h1>
    <a class="mag-app-btn" href={siteHref}>{copy.site}</a>
  </section>

  <main class="mag-app-hub" data-app-hub hidden>
    <header class="mag-app-top">
      <div class="mag-app-brand" aria-label="Magister">
        <MagisterLogo class="mag-app-top__logo" level width={200} height={88} />
      </div>
      <div class="mag-app-lang">
        <button
          class="mag-app-lang__toggle"
          type="button"
          data-lang-toggle
          aria-expanded="false"
          aria-controls="mag-app-lang-menu"
          aria-label={copy.lang_label}
        >
          <span class="mag-app-lang__icon" aria-hidden="true">文</span>
          <span class="mag-app-lang__code">{currentLang.label}</span>
        </button>
        <div class="mag-app-lang__menu" id="mag-app-lang-menu" data-lang-menu hidden>
          {
            LOCALE_LINKS.map((item) => (
              <a
                href={getLocalizedPath('/app', item.code)}
                class:list={{ 'is-active': item.code === lang }}
                lang={item.code === 'zh' ? 'zh-Hans' : item.code}
                hreflang={item.code === 'zh' ? 'zh-Hans' : item.code}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <div class="mag-app-carousel" data-carousel>
      <div class="mag-app-intro" data-app-intro>
        <h1 class="mag-app-kicker" data-active-title>{doors[startIndex]?.title ?? ''}</h1>
      </div>

      <div class="mag-app-carousel__stage">
      <button class="mag-app-carousel__nav mag-app-carousel__nav--prev" type="button" data-carousel-prev aria-label={copy.prev}>
        <span aria-hidden="true">‹</span>
      </button>

      <div class="mag-app-carousel__viewport">
        <div
          class="mag-app-carousel__track"
          data-carousel-track
          style="--carousel-drag: 0px;"
        >
          {
            doors.map((door) => (
              <article
                class:list={[
                  'mag-app-card',
                  door.kind === 'prose' && 'mag-app-card--prose',
                  door.lockedUntil && 'is-locked',
                  door.soon && 'is-soon',
                ]}
                data-door={door.id}
                data-title={door.title}
                data-blurb={door.blurb}
                data-detail={door.detail.join(HUB_DETAIL_SEP)}
                data-cta={door.cta}
                data-lock-text={door.lockedUntil ? games.menu.birth_lock : undefined}
                data-soon={door.soon ? '1' : undefined}
                data-soon-text={door.soon ? copy.soon_title : undefined}
                data-locked-until={door.lockedUntil}
                aria-disabled={door.lockedUntil ? 'true' : undefined}
                aria-label={door.title}
                role="button"
                tabindex="-1"
              >
                <div class="mag-app-card__frame">
                  {
                    door.kind === 'prose' ? (
                      <div class="mag-app-card__prose">
                        <p class="mag-app-card__prose-brand">{copy.deck_intro.title}</p>
                        <div class="mag-app-card__prose-body">
                          {copy.deck_intro.paragraphs.map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                        </div>
                        {copy.deck_intro.signoff.trim() ? (
                          <p class="mag-app-card__prose-signoff">{copy.deck_intro.signoff}</p>
                        ) : null}
                      </div>
                    ) : (
                      <div class:list={['mag-app-card__art', door.fit === 'cover' && 'mag-app-card__art--cover']} aria-hidden="true">
                        <img src={door.art} alt="" width={door.artW} height={door.artH} decoding="async" draggable="false" />
                      </div>
                    )
                  }
                  {(door.lockedUntil || door.soon) && (
                    <span class="mag-app-card__seal" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <rect x="5.5" y="11" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4"></rect>
                        <path d="M8 11V8.2a4 4 0 0 1 8 0V11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                      </svg>
                    </span>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <button class="mag-app-carousel__nav mag-app-carousel__nav--next" type="button" data-carousel-next aria-label={copy.next_slide}>
        <span aria-hidden="true">›</span>
      </button>
      </div>

      <div class="mag-app-carousel__dots" data-carousel-dots role="tablist" aria-label={copy.hub_kicker}>
        {
          doors.map((door, i) => (
            <button
              class:list={['mag-app-carousel__dot', i === startIndex && 'is-active']}
              type="button"
              data-carousel-dot={i}
              aria-label={door.title}
              aria-current={i === startIndex ? 'true' : 'false'}
            />
          ))
        }
      </div>
    </div>

    <div class="mag-app-caption" data-app-caption>
      <p class="mag-app-caption__blurb" data-active-blurb>{doors[startIndex]?.blurb ?? ''}</p>
      <div class="mag-app-caption__detail" data-active-detail hidden></div>
      <p class="mag-app-caption__lock is-empty" data-active-lock></p>
      <button class="mag-app-caption__cta" type="button" data-active-cta>
        {doors[startIndex]?.cta ?? copy.cta_open}
      </button>
    </div>

    <footer class="mag-app-footer">
      <a class="mag-app-footer__site" href={siteHref}>{copy.site}</a>
    </footer>
  </main>

  <section class="mag-app-panel mag-app-panel--cards" data-panel="cards" hidden>
    <section class="play-games play-games--app" aria-label={copy.nav_cards}>
      <div class="play-app-root">
        <div class="play-stage mag-app-cards-stage">
          <div class="play-stage-bar">
            <button class="play-nav-back" type="button" data-app-action="back">
              <span class="play-nav-mark" aria-hidden="true">←</span>
              <span class="play-nav-label">{copy.back}</span>
            </button>
            <p class="play-stage-name">
              <MagisterLogo class="play-stage-logo" level width={112} height={49} />
              <span>{copy.nav_cards}</span>
            </p>
          </div>
          <Gallery lang={lang} variant="app" />
        </div>
      </div>
    </section>
  </section>

  <section class="mag-app-panel mag-app-panel--play" data-panel="play" hidden>
    <Games lang={lang} variant="app" />
  </section>

  <DeckGuide lang={lang} backLabel={copy.back} shopHref={shopHref} />

  <section class="mag-app-panel mag-app-panel--online" data-panel="online" hidden>
    <header class="mag-app-panel__bar mag-app-panel__bar--online">
      <button class="mag-app-back mag-app-back--pill" type="button" data-app-action="back">
        <span aria-hidden="true">←</span>
        {copy.back}
      </button>
      <div class="mag-app-panel__brand">
        <MagisterLogo class="mag-app-panel__logo mag-app-panel__logo--online" level width={108} height={47} />
      </div>
      <div class="mag-app-online-menu" data-app-online-menu>
        <button
          class="mag-app-online-menu__toggle"
          type="button"
          data-app-online-menu-toggle
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label={onlineMenu.menu_open}
        >
          <span aria-hidden="true">⋯</span>
        </button>
        <div class="mag-app-online-menu__panel" data-app-online-menu-panel role="menu" hidden>
          <button type="button" role="menuitem" data-app-online-menu-copy>
            {onlineMenu.menu_copy}
          </button>
          <button type="button" role="menuitem" data-app-online-menu-bot>
            {onlineMenu.menu_add_bot}
          </button>
          <button type="button" role="menuitem" data-app-online-menu-restart>
            {onlineMenu.menu_restart}
          </button>
        </div>
      </div>
    </header>
    <OnlineTable lang={lang} backLabel={copy.back} initialRoom={null} />
  </section>

  <section class="mag-app-panel" data-panel="buy" hidden>
    <header class="mag-app-panel__bar">
      <button class="mag-app-back" type="button" data-app-action="back">
        <span aria-hidden="true">←</span>
        {copy.buy_back}
      </button>
      <h2 class="mag-app-panel__title">{copy.buy_title}</h2>
    </header>
    <div class="mag-app-panel__body mag-app-buy">
      <img class="mag-app-buy__art" src="/media/deck-lifestyle.jpg" alt="" width="1024" height="672" decoding="async" />
      <p class="mag-app-buy__blurb">{copy.buy_blurb}</p>
      <p class="mag-app-buy__price">{price}</p>
      <a class="mag-app-btn mag-app-btn--accent" href={shopHref}>{copy.buy_cta}</a>
    </div>
  </section>

  <div class="mag-app-lock" data-app-lock hidden>
    <button class="mag-app-lock__scrim" type="button" data-app-action="lock-close" aria-label={copy.back}></button>
    <div class="mag-app-lock__card" role="dialog" aria-modal="true" aria-labelledby="mag-app-lock-title">
      <h2 id="mag-app-lock-title" data-app-lock-title tabindex="-1">{copy.lock_title}</h2>
      <p>{copy.lock_body}</p>
      <div class="mag-app-lock__actions">
        <button class="mag-app-btn" type="button" data-app-action="lock-close">{copy.back}</button>
        <button class="mag-app-btn mag-app-btn--accent" type="button" data-app-action="lock-play">
          {copy.lock_cta}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { mountAppShell } from '../scripts/app-shell';
  mountAppShell();
</script>

<style is:global>
  html.mag-app-active {
    scroll-padding-top: 0;
  }

  body.mag-app-body {
    background: #080d18;
    color: #f0e7d5;
    min-height: 100dvh;
  }

  body.mag-app-body .skip-link {
    display: none;
  }

  .mag-app {
    --app-ground: #080d18;
    --app-panel: #111b2b;
    --app-card: #142238;
    --app-parchment: #f0e7d5;
    --app-dim: #aaa9b5;
    --app-gold: #c7a36a;
    --app-gold-hot: #ecd09b;
    --app-line: rgba(199, 163, 106, 0.28);
    --card-radius: clamp(0.55rem, 4.6%, 0.9rem);
    --slide-gap: 0.85rem;
    --carousel-ease: cubic-bezier(0.25, 0.92, 0.35, 1);
    --carousel-dur: 560ms;
    --display: 'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
    --sans: 'Manrope', 'Noto Sans SC', system-ui, sans-serif;
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    min-height: 100svh;
    background:
      radial-gradient(ellipse 80% 48% at 50% -8%, rgba(199, 163, 106, 0.1), transparent 56%),
      radial-gradient(circle at 8% 82%, rgba(20, 34, 56, 0.9), transparent 44%),
      var(--app-ground);
    color: var(--app-parchment);
    font-family: var(--sans);
    overflow-x: clip;
  }

  .mag-app::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.2;
    background:
      radial-gradient(circle at 50% 38%, transparent 20%, rgba(199, 163, 106, 0.045) 21%, transparent 48%),
      radial-gradient(circle at 20% 30%, transparent 0 1px, rgba(199, 163, 106, 0.22) 1px 1.5px, transparent 2px) 0 0 / 8rem 8rem;
  }

  .mag-app [hidden] {
    display: none !important;
  }

  .mag-app-boot {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-content: center;
    gap: 1.5rem;
    background: var(--app-ground);
    transition: opacity 400ms ease, visibility 400ms ease;
  }

  .mag-app-boot.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mag-app-boot__mark {
    display: grid;
    place-items: center;
  }

  .mag-app-boot__logo {
    width: min(58vw, 12.5rem);
    height: auto;
    animation: mag-app-breathe 2.4s ease-in-out infinite;
  }

  @keyframes mag-app-breathe {
    0%,
    100% {
      opacity: 0.72;
      transform: rotate(calc(var(--brand-wordmark-rotate-design) * -1)) scale(0.98);
    }
    50% {
      opacity: 1;
      transform: rotate(calc(var(--brand-wordmark-rotate-design) * -1)) scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mag-app-boot__logo {
      animation: none;
      opacity: 1;
    }
  }

  .mag-app-boot__cue {
    text-align: center;
    color: var(--app-dim);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .mag-app-age,
  .mag-app-hub,
  .mag-app-panel {
    width: min(100%, 34rem);
    margin: 0 auto;
    padding:
      max(0.85rem, env(safe-area-inset-top))
      max(0.75rem, env(safe-area-inset-right))
      max(1.25rem, env(safe-area-inset-bottom))
      max(0.75rem, env(safe-area-inset-left));
  }

  .mag-app-hub {
    --hub-w: min(100vw, 26.75rem);
    --hub-chrome: 18.25rem;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    min-height: 100svh;
    width: var(--hub-w);
    padding:
      max(0.45rem, env(safe-area-inset-top))
      0
      max(0.7rem, env(safe-area-inset-bottom));
  }

  .mag-app-age {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }

  .mag-app-age__logo {
    margin: 0 auto 0.35rem;
    width: 10.5rem;
    height: auto;
  }

  .mag-app-age__title,
  .mag-app-panel__title,
  .mag-app-stub h3,
  .mag-app-lock__card h2 {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .mag-app-age__title {
    font-size: clamp(1.75rem, 7vw, 2.4rem);
  }

  .mag-app-age__lead,
  .mag-app-stub p,
  .mag-app-buy__blurb,
  .mag-app-lock__card p {
    color: var(--app-dim);
    line-height: 1.5;
  }

  .mag-app-age__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .mag-app-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--app-line);
    background: transparent;
    color: var(--app-parchment);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .mag-app-btn--accent {
    border-color: var(--app-gold);
    background: linear-gradient(180deg, rgba(199, 163, 106, 0.28), rgba(20, 34, 56, 0.55));
    color: var(--app-gold-hot);
  }

  .mag-app-btn:focus-visible,
  .mag-app-card:focus-visible,
  .mag-app-back:focus-visible,
  .mag-app-carousel__nav:focus-visible,
  .mag-app-carousel__dot:focus-visible,
  .mag-app-lang__toggle:focus-visible {
    outline: 2px solid var(--app-gold-hot);
    outline-offset: 3px;
  }

  .mag-app-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.65rem;
    margin: 0 0 0.55rem;
    padding-inline: max(0.85rem, env(safe-area-inset-left)) max(0.85rem, env(safe-area-inset-right));
  }

  .mag-app-brand {
    display: inline-flex;
    min-width: 0;
  }

  .mag-app-top__logo {
    width: min(42vw, 8.5rem);
    height: auto;
  }

  .mag-app-lang {
    position: relative;
    flex: 0 0 auto;
  }

  .mag-app-intro {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    min-height: 4.35rem;
    margin: 0.65rem 0 0.45rem;
    padding-inline: max(0.85rem, env(safe-area-inset-left)) max(0.85rem, env(safe-area-inset-right));
    transition:
      opacity calc(var(--carousel-dur) / 2) var(--carousel-ease),
      transform calc(var(--carousel-dur) / 2) var(--carousel-ease);
  }

  .mag-app-intro.is-chrome-fade {
    opacity: 0;
    transform: translateY(6px);
  }

  .mag-app-kicker {
    margin: 0;
    width: 100%;
    max-width: min(100%, calc(var(--slide-w, 16rem) + 1.5rem));
    margin-inline: auto;
    min-height: 2.2em;
    font-family: var(--display);
    font-size: clamp(1.95rem, 8.5vw, 2.55rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--app-gold-hot);
    text-wrap: balance;
    text-shadow: 0 1px 0 rgba(8, 13, 24, 0.35);
  }

  .mag-app-kicker::after {
    content: '';
    display: block;
    width: min(4.5rem, 38%);
    height: 1px;
    margin: 0.45rem auto 0;
    background: linear-gradient(90deg, transparent, rgba(199, 163, 106, 0.85), transparent);
    opacity: 0.9;
  }

  .mag-app-lang__toggle {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--app-line);
    border-radius: 999px;
    background: rgba(17, 27, 43, 0.85);
    color: var(--app-gold-hot);
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .mag-app-lang__icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .mag-app-lang__menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 12;
    display: flex;
    flex-direction: column;
    min-width: 5.5rem;
    padding: 0.35rem;
    border: 1px solid var(--app-line);
    background: var(--app-panel);
    box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.45);
  }

  .mag-app-lang__menu a {
    padding: 0.45rem 0.55rem;
    color: var(--app-dim);
    text-decoration: none;
    font-size: 0.78rem;
