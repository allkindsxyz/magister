---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { CONTACT_EMAIL } from '../lib/site';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath('/', lang);
const deckHref = getLocalizedPath('/artifacts/deck', lang);
const apparelHref = getLocalizedPath('/artifacts/apparel', lang);
const printsHref = getLocalizedPath('/artifacts/prints', lang);
const partnersHref = getLocalizedPath('/partners/', lang);
---

<footer class="buyer-footer" id="updates">
  <div class="page-shell buyer-footer__inner">
    <p class="buyer-footer__brand" aria-label="Magister Cards">
      <MagisterLogo class="buyer-footer__logo" width={320} height={148} />
    </p>
    <h2 class="buyer-footer__title">{t('footer.ready_title')}</h2>
    <p class="buyer-footer__line">{t('footer.ready_line')}</p>
    <a class="btn btn-accent" href={deckHref}>{t('footer.order')}</a>
    <nav class="buyer-footer__shop" aria-label={t('footer.shop_aria')}>
      <a href={apparelHref}>{t('footer.apparel')}</a>
      <a href={printsHref}>{t('footer.prints')}</a>
      <a href={`${home}#play`}>{t('footer.play')}</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
    <div class="buyer-footer__mail">
      <p>{t('footer.mail_lead')}</p>
      <form class="buyer-footer__form" id="buyer-wait-form">
        <label class="visually-hidden" for="buyer-email">Email</label>
        <input
          id="buyer-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
        />
        <button class="btn" type="submit">{t('footer.notify')}</button>
      </form>
      <p class="buyer-footer__ok" id="buyer-wait-ok" hidden>{t('footer.on_list')}</p>
    </div>
    <p class="buyer-footer__copy">
      © 2026 Magister Cards
      <span aria-hidden="true">·</span>
      <a href={partnersHref}>{t('footer.publishers')}</a>
    </p>
  </div>
</footer>

<script>
  const form = document.getElementById('buyer-wait-form');
  const ok = document.getElementById('buyer-wait-ok');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (ok) ok.hidden = false;
    if (form instanceof HTMLFormElement) form.reset();
  });
</script>

<style>
  .buyer-footer {
    padding-block: clamp(3.5rem, 8vw, 5.5rem) calc(2.5rem + env(safe-area-inset-bottom, 0px));
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }

  .buyer-footer__inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .buyer-footer__brand {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0 0 0.5rem;
  }

  /* Logo PNG is already white-on-blue — never invert (that flattens it to a white blob). */
  .buyer-footer__brand :global(img.buyer-footer__logo),
  .buyer-footer__brand :global(img.magister-logo) {
    display: block;
    width: min(100%, 11rem) !important;
    height: auto !important;
    max-width: none !important;
    margin-inline: auto;
    filter: none !important;
    -webkit-filter: none !important;
  }

  .buyer-footer__title {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--paper);
  }

  .buyer-footer__line {
    margin: 0;
    max-width: 28rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    line-height: 1.55;
  }

  .buyer-footer .btn-accent {
    margin-top: 0.75rem;
  }

  .buyer-footer__shop {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem 1.35rem;
    margin-top: 0.75rem;
  }

  .buyer-footer__shop a {
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    text-underline-offset: 0.2em;
  }

  .buyer-footer__shop a:hover {
    color: var(--paper);
  }

  .buyer-footer__mail {
    width: min(100%, 28rem);
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 16%, transparent);
  }

  .buyer-footer__mail > p {
    margin: 0 0 0.85rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-size: 0.9rem;
  }

  .buyer-footer__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .buyer-footer__form input {
    flex: 1 1 12rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
    background: transparent;
    color: var(--paper);
  }

  .buyer-footer__form input::placeholder {
    color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .buyer-footer__mail .btn {
    border-color: color-mix(in srgb, var(--paper) 40%, transparent);
    color: var(--paper);
    background: transparent;
  }

  .buyer-footer__ok {
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--paper) 80%, #c8973a);
  }

  .buyer-footer__ok[hidden] {
    display: none !important;
  }

  .buyer-footer__copy {
    margin-top: 1.75rem;
    color: color-mix(in srgb, var(--paper) 42%, transparent);
    font-size: 0.85rem;
  }

  .buyer-footer__copy a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  .buyer-footer__copy span {
    margin-inline: 0.35rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
