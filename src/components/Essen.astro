---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { authorPhotoSrc } from '../lib/authorPhotos';
import { BOOKING_URL, PARTNERSHIP_EMAIL } from '../lib/site';
import SpielLogo from './SpielLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const team = [
  { key: 'matison', image: authorPhotoSrc('dmitry-matison') },
  { key: 'lightovy', image: authorPhotoSrc('alex-lightovy') },
] as const;
---

<section class="spiel editorial-section" id="spiel" aria-labelledby="spiel-title">
  <div class="page-shell spiel-shell">
    <header class="spiel-header reveal">
      <h2 class="spiel-title" id="spiel-title">
        <span class="spiel-title-row">
          <SpielLogo class="spiel-title-logo" width={220} height={96} />
          <span class="spiel-title-text">{t('essen.headline')}</span>
        </span>
      </h2>
      <p class="spiel-meta">{t('essen.date')}</p>
      <p class="spiel-lead">{t('essen.lead')}</p>
    </header>

    <div class="spiel-team">
      {team.map((person) => (
        <article class="team-member reveal">
          {person.image && (
            <img
              src={person.image}
              alt={t(`essen.${person.key}.photo_alt`)}
              width="205"
              height="205"
              loading="lazy"
              decoding="async"
            />
          )}
          <div>
            <h3>{t(`essen.${person.key}.name`)}</h3>
            <p class="team-role">{t(`essen.${person.key}.role`)}</p>
            <p class="team-bio">{t(`essen.${person.key}.bio`)}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="spiel-actions reveal">
      <a class="btn btn-accent" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">
        <span class="btn-event-mark" aria-hidden="true">✦</span>
        {t('hero.meet')}
      </a>
      <p class="spiel-alt-contact">
        {t('essen.contact_prefix')}
        {' '}
        <a href={`mailto:${PARTNERSHIP_EMAIL}`}>{PARTNERSHIP_EMAIL}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .spiel {
    background: var(--paper);
    border-color: var(--line);
  }

  .spiel-shell {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .spiel-header {
    max-width: min(100%, 52rem);
  }

  .spiel-title {
    margin: 0;
    font: inherit;
  }

  .spiel-title-row {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.5vw, 1.1rem);
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .spiel-title-row {
      flex-wrap: nowrap;
    }
  }

  .spiel-title-text {
    font-family: var(--display);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .spiel-title-logo {
    flex: 0 0 auto;
    display: block;
    width: auto;
    height: clamp(2.35rem, 4vw, 3.15rem);
  }

  .spiel-meta {
    margin-top: 0.75rem;
    color: var(--accent);
    font: 500 0.95rem/1.5 var(--sans);
    letter-spacing: 0.02em;
  }

  .spiel-lead {
    margin-top: 0.85rem;
    max-width: 36rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .spiel-team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .team-member {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }

  .team-member img {
    flex: 0 0 5.2rem;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 22%;
    filter: saturate(0.88);
  }

  .team-member h3 {
    font-family: var(--display);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .team-role {
    margin-top: 0.35rem;
    color: var(--accent);
    font: 600 0.58rem/1.45 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .team-bio {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .spiel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .spiel-alt-contact {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .spiel-alt-contact a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .spiel-alt-contact a:hover {
    color: var(--accent-dark);
  }

  @media (max-width: 720px) {
    .spiel-team {
      grid-template-columns: 1fr;
    }
  }
</style>
