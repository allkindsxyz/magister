---
import type { Lang } from '../i18n/utils';
import { pickLocalized } from '../i18n/utils';
import { playWaysCopy } from '../i18n/playWaysCopy';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = playWaysCopy[lang];

const allCards = await getCollection('cards');
const byId = new Map(
  allCards.map((card) => [
    card.data.id,
    { image: card.data.image as string, title: pickLocalized(card.data.title, lang) },
  ]),
);
---

{copy && (
<section class="play-ways editorial-section" id="play-ways" aria-labelledby="play-ways-title">
  <div class="page-shell">
    <header class="play-ways__header">
      <p class="section-label">{copy.label}</p>
      <h2 class="section-title" id="play-ways-title">{copy.title}</h2>
      <p class="play-ways__lead">{copy.lead}</p>
    </header>

    <div class="play-ways__grid">
      {copy.ways.map((way, index) => {
        const card = byId.get(way.card);
        return (
          <article class="play-ways__way" style={`--delay:${index * 70}ms`}>
            {card && (
              <div class="play-ways__visual">
                <span class="play-ways__frame">
                  <img
                    src={card.image}
                    alt={card.title}
                    width="280"
                    height="392"
                    loading="eager"
                    decoding="async"
                  />
                </span>
              </div>
            )}
            <h3>{way.title}</h3>
            <p class="play-ways__format">
              {way.format}
              {way.soon && <span>{copy.soon}</span>}
            </p>
            <p>{way.body}</p>
            <ul>
              {way.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {way.cta && (
              <a class="text-link" href={way.cta.href}>{way.cta.label}</a>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
)}

<style>
  .play-ways {
    background: var(--paper);
  }

  .play-ways__header {
    max-width: 44rem;
  }

  .play-ways__header .section-title {
    max-width: 12ch;
    margin-top: 1rem;
    font-size: clamp(2.2rem, 4.6vw, 4.6rem);
    line-height: 1;
  }

  .play-ways__lead,
  .play-ways__way > p:not(.play-ways__format) {
    color: var(--muted);
    line-height: 1.75;
  }

  .play-ways__lead {
    margin-top: 1.75rem;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
  }

  .play-ways__grid {
    display: grid;
    gap: 1px;
    margin-top: clamp(3rem, 5.5vw, 5rem);
    border: 1px solid var(--line);
    background: var(--line);
  }

  .play-ways__way {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: 0.55rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper);
  }

  .play-ways__visual {
    width: min(100%, 9.5rem);
    margin-bottom: 0.4rem;
  }

  .play-ways__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 920 / 1316;
    overflow: hidden;
    border-radius: var(--card-radius);
    background: var(--paper-deep);
  }

  .play-ways__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.12);
    transform-origin: center center;
  }

  .play-ways__way h3 {
    font-family: var(--display);
    font-size: clamp(1.45rem, 2.1vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .play-ways__format {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.7rem;
    margin: 0;
    color: var(--muted);
    font: 600 0.68rem/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .play-ways__format span {
    color: var(--accent);
  }

  .play-ways__way > p:not(.play-ways__format) {
    margin: 0;
    font-size: 0.95rem;
  }

  .play-ways__way ul {
    display: flex;
    flex-wrap: wrap;
    align-self: end;
    gap: 0.4rem 0.55rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .play-ways__way li {
    padding: 0.28rem 0.65rem;
    border: 1px solid var(--line);
    color: var(--ink);
    font: 600 0.68rem/1.2 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .play-ways__way .text-link {
    margin-top: 0.35rem;
    justify-self: start;
  }

  @media (min-width: 860px) {
    .play-ways__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 859px) {
    .play-ways__header .section-title {
      font-size: clamp(1.7rem, 7.2vw, 2.6rem);
    }

    .play-ways__way {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      grid-template-rows: auto auto auto auto auto;
      column-gap: 1.25rem;
    }

    .play-ways__visual {
      grid-row: 1 / 6;
      width: auto;
      margin: 0;
    }
  }

  @media (max-width: 520px) {
    .play-ways__way {
      grid-template-columns: 1fr;
    }

    .play-ways__visual {
      grid-row: auto;
      width: min(100%, 9.5rem);
    }
  }
</style>
