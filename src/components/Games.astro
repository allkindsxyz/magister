  .play-ring {
    width: 100%;
    height: 100%;
  }

  .play-ring-track,
  .play-ring-value {
    fill: none;
    stroke-width: 2;
  }

  .play-ring-track {
    stroke: var(--line);
  }

  .play-ring-value {
    stroke: var(--accent);
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 60px 60px;
  }

  .play-ring-num {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: 2.5rem;
    font-variant-numeric: tabular-nums;
