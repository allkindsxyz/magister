    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .play-asked span:last-child {
    font-family: var(--display);
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .play-fan {
    position: relative;
    height: 9rem;
    margin: 1rem auto;
    width: min(100%, 24rem);
  }

  .play-fan img {
    --shift: 0rem;
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 4.4rem;
    height: auto;
    border-radius: var(--card-radius);
    box-shadow: 0 0.6rem 1.4rem rgba(23, 23, 20, 0.18);
    animation: play-riffle 0.48s ease-in-out infinite alternate;
  }

  .play-fan img:nth-child(1) { --shift: -7.2rem; animation-delay: 0s; }
  .play-fan img:nth-child(2) { --shift: -3.6rem; animation-delay: 0.08s; }
  .play-fan img:nth-child(3) { --shift: 0rem; animation-delay: 0.16s; }
  .play-fan img:nth-child(4) { --shift: 3.6rem; animation-delay: 0.04s; }
  .play-fan img:nth-child(5) { --shift: 7.2rem; animation-delay: 0.12s; }

  .play-flip {
    width: min(100%, 16rem);
    margin-inline: auto;
    perspective: 1000px;
  }

  .play-flip-inner {
    position: relative;
    aspect-ratio: 920 / 1316;
    transform-style: preserve-3d;
    transition: transform 0.7s ease;
  }

  .play-flip.is-down .play-flip-inner {
    transform: rotateY(180deg);
  }

  .play-flip-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--card-radius);
    backface-visibility: hidden;
  }

  .play-flip-back {
    display: grid;
    place-items: center;
    background: var(--play-ink);
    color: var(--play-gold);
    transform: rotateY(180deg);
    font-family: var(--display);
    font-size: 1.35rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .play-flip-front img {
    height: 100%;
    object-fit: cover;
    box-shadow: none;
  }

  .play-live {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes play-shake {
    0%,
    100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  @keyframes play-riffle {
    from { translate: calc(-50% + var(--shift)) 0; }
    to { translate: calc(-50% + var(--shift) + 16px) -8px; }
  }

  .play-zoom {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(13, 11, 9, 0.94);
  }

  .play-zoom-close {
    position: absolute;
    top: max(0.85rem, env(safe-area-inset-top));
    right: max(0.85rem, env(safe-area-inset-right));
    z-index: 1;
    padding: 0.55rem 0.8rem;
    border: 0;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    font: 600 0.68rem/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
