---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PARTNERSHIP_EMAIL } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  {
    key: 'deck',
    image: '/media/pack.png',
    width: 1536,
    height: 1024,
    href: '#fifty-four',
  },
  {
    key: 'apparel',
    image: '/media/partner-apparel.jpg',
    width: 764,
    height: 1024,
    href: `mailto:${PARTNERSHIP_EMAIL}?subject=${encodeURIComponent('Magister Apparel')}`,
  },
  {
    key: 'prints',
    image: '/media/partner-print.jpg',
    width: 713,
    height: 1024,
    href: `mailto:${PARTNERSHIP_EMAIL}?subject=${encodeURIComponent('Magister Art Prints')}`,
  },
  {
    key: 'album',
    image: '/media/partner-album.jpg',
    width: 1024,
    height: 724,
    href: `mailto:${PARTNERSHIP_EMAIL}?subject=${encodeURIComponent('Magister Art Album')}`,
  },
] as const;
---

<section class="artifacts editorial-section" id="artifacts" aria-labelledby="artifacts-title">
  <div class="page-shell">
    <header class="artifacts-header reveal">
      <p class="section-label">{t('next.label')}</p>
      <h2 class="section-title" id="artifacts-title">{t('next.title')}</h2>
      <p class="artifacts-lead">{t('next.lead')}</p>
    </header>

    <div class="artifacts-grid">
      {items.map((item) => (
        <article class="artifact-card reveal">
          <div class="artifact-card__copy">
            <h3 class="artifact-card__title">{t(`next.${item.key}.title`)}</h3>
            <p class="artifact-card__lead">{t(`next.${item.key}.lead`)}</p>
            <p class="artifact-card__body">{t(`next.${item.key}.body`)}</p>
            <a class="text-link artifact-card__cta" href={item.href}>
              {t(`next.${item.key}.cta`)} →
            </a>
          </div>
          <figure class="artifact-card__media">
            <img
              src={item.image}
              alt={t(`next.${item.key}.image_alt`)}
              width={item.width}
              height={item.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>
