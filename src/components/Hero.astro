---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { getCollection } from 'astro:content';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const deckHref = getLocalizedPath('/artifacts/deck', lang);

const allCards = await getCollection('cards');
const heroImages = allCards
  .filter((c) => !c.data.back && c.data.suit && c.data.value)
  .map((c) => c.data.image as string);
const heroFirst = heroImages[0] ?? '/media/selected-work.webp';
---

<section class="hero hero--bleed" id="deck" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true" data-hero-media>
    <img
      class="hero__stage is-front is-in"
      data-hero-a
      src={heroFirst}
      alt=""
      width="1200"
      height="1680"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <img
      class="hero__stage"
      data-hero-b
      src={heroFirst}
      alt=""
      width="1200"
      height="1680"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="page-shell hero__copy">
    <p class="hero__meta">{t('hero.meta')}</p>
    <h1 id="hero-title" class="hero__title" aria-label="Magister Cards">
      <span class="hero__wordmark" aria-hidden="true">
        <MagisterLogo width={880} height={407} />
      </span>
    </h1>
    <p class="hero__lead">
      {t('hero.lead_before')}<span class="hero__mark">{t('hero.lead_mark')}</span>{t('hero.lead_after')}
    </p>
    <p class="hero__body">{t('hero.body')}</p>
    <div class="hero__actions">
      <a class="btn btn-accent" href={deckHref}>{t('hero.buy')}</a>
      <button class="btn hero__btn-light" type="button" data-destiny-open aria-haspopup="dialog" aria-controls="destiny-sheet">
        {t('hero.birth_cta')}
      </button>
    </div>
  </div>
</section>

<script define:vars={{ heroImages }}>
  const HERO_FADE_MS = 3000;
  const HERO_HOLD_MS = 5000;
  const heroUrls = Array.isArray(heroImages) ? heroImages.filter(Boolean) : [];
  const heroA = document.querySelector('[data-hero-a]');
  const heroB = document.querySelector('[data-hero-b]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** @param {number} ms */
  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  /** @param {string} url @returns {Promise<void>} */
  function preloadHero(url) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = () => resolve();
      img.src = url;
    });
  }

  /** @param {HTMLImageElement} el */
  function clearHeroMotion(el) {
    el.getAnimations().forEach((a) => a.cancel());
    el.classList.remove('is-in', 'is-drift', 'is-front');
    el.style.transition = 'none';
    el.style.transform = '';
  }

  /** @param {HTMLImageElement} el */
  function startDrift(el) {
    el.getAnimations().forEach((a) => a.cancel());
    el.style.transform = 'scale(1.02) translate3d(0, 0, 0)';
    const xDir = Math.random() < 0.5 ? -1 : 1;
    const yDir = Math.random() < 0.5 ? -1 : 1;
    const x = xDir * (0.55 + Math.random() * 0.55);
    const y = yDir * (0.4 + Math.random() * 0.5);
    el.classList.add('is-drift');
    el.animate(
      [
        { transform: 'scale(1.02) translate3d(0, 0, 0)' },
        { transform: `scale(1.06) translate3d(${x}%, ${y}%, 0)` },
      ],
      { duration: 16000, easing: 'linear', fill: 'forwards' },
    );
  }

  /** @param {HTMLImageElement} el */
  function freezeDrift(el) {
    const endTransform = getComputedStyle(el).transform;
    el.getAnimations().forEach((a) => a.cancel());
    el.classList.remove('is-drift');
    el.style.transform = endTransform === 'none' ? 'scale(1.04)' : endTransform;
  }

  if (heroA instanceof HTMLImageElement && heroB instanceof HTMLImageElement) {
    if (reduceMotion || heroUrls.length === 0) {
      heroA.classList.add('is-in', 'is-front');
    } else {
      let index = 0;
      /** @type {HTMLImageElement} */
      let front = heroA;
      /** @type {HTMLImageElement} */
      let back = heroB;

      const boot = async () => {
        front.src = heroUrls[0];
        clearHeroMotion(front);
        clearHeroMotion(back);
        front.classList.add('is-front');
        void front.offsetWidth;
        requestAnimationFrame(() => {
          front.style.transition = 'opacity 3s linear';
          requestAnimationFrame(() => {
            front.classList.add('is-in');
            startDrift(front);
          });
        });
        await wait(HERO_HOLD_MS);
        await crossfade();
        loop();
      };

      const crossfade = async () => {
        const nextIndex = (index + 1) % heroUrls.length;
        await preloadHero(heroUrls[nextIndex]);
        freezeDrift(front);
        clearHeroMotion(back);
        back.src = heroUrls[nextIndex];
        back.style.transform = 'scale(1.02)';
        back.classList.add('is-front');
        front.classList.remove('is-front');
        void back.offsetWidth;
        requestAnimationFrame(() => {
          front.style.transition = 'opacity 3s linear';
          back.style.transition = 'opacity 3s linear';
          requestAnimationFrame(() => {
            back.classList.add('is-in');
            front.classList.remove('is-in');
          });
        });
        await wait(HERO_FADE_MS);
        clearHeroMotion(front);
        const prev = front;
        front = back;
        back = prev;
        front.style.transition = 'none';
        front.style.transform = '';
        front.getAnimations().forEach((a) => a.cancel());
        front.classList.add('is-in', 'is-front');
        index = nextIndex;
      };

      const loop = async () => {
        preloadHero(heroUrls[(index + 1) % heroUrls.length]);
        startDrift(front);
        await wait(HERO_HOLD_MS);
        await crossfade();
        loop();
      };

      boot();
    }
  }
</script>

<style>
  .hero--bleed {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: clip;
    color: var(--white);
    background: #1a140c;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #1a140c;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    opacity: 0;
    transform: scale(1.02);
    transform-origin: 50% 28%;
    transition: opacity 3s linear;
    will-change: opacity, transform;
  }

  .hero__stage.is-front {
    z-index: 1;
  }

  .hero__stage.is-in {
    opacity: 1;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(12, 10, 6, 0.58) 0%, rgba(12, 10, 6, 0.22) 38%, transparent 70%),
      linear-gradient(0deg, rgba(12, 10, 6, 0.42) 0%, transparent 40%);
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    padding-block: clamp(7rem, 14vw, 10rem) clamp(4rem, 8vw, 6.5rem);
    max-width: 42rem;
    margin-inline: 0;
    animation: hero-copy-in 900ms ease both;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__meta {
    margin: 0;
    color: color-mix(in srgb, var(--white) 78%, #c8973a);
    font: 600 0.68rem/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 1.35rem 0 0;
    max-width: 22rem;
  }

  .hero__wordmark {
    display: block;
    line-height: 0;
    filter: drop-shadow(0 0.45rem 1.1rem rgba(0, 0, 0, 0.45));
  }

  .hero__wordmark :global(.magister-logo) {
    width: min(100%, 20rem);
    height: auto;
    max-width: none;
  }

  .hero__lead {
    margin: 1.75rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.45rem, 2.4vw, 2.05rem);
    font-weight: 400;
    line-height: 1.28;
    max-width: 28rem;
  }

  .hero__mark {
    color: color-mix(in srgb, var(--white) 88%, #c8973a);
  }

  .hero__body {
    margin: 1rem 0 0;
    max-width: 28rem;
    color: color-mix(in srgb, var(--white) 78%, transparent);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__btn-light {
    border-color: color-mix(in srgb, var(--white) 70%, transparent);
    color: var(--white);
    background: transparent;
    cursor: pointer;
  }

  .hero__btn-light:hover {
    background: var(--white);
    color: var(--ink);
  }

  .hero--bleed .btn-accent {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage,
    .hero__copy {
      animation: none !important;
      transition: none !important;
    }

    .hero__stage {
      opacity: 1;
      transform: scale(1.02);
    }
  }

  @media (max-width: 720px) {
    .hero__stage {
      object-position: center 22%;
    }

    .hero__wordmark :global(.magister-logo) {
      width: min(100%, 16rem);
    }
  }
</style>
