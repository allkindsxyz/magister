---
import type { Lang } from '../i18n/utils';
import { useTranslations, getLocalizedPath, pickLocalized } from '../i18n/utils';
import { getCollection } from 'astro:content';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const deckHref = getLocalizedPath('/artifacts/deck', lang);

const SUITS = ['hearts', 'diamonds', 'clubs', 'spades'] as const;
const SYMBOLS: Record<(typeof SUITS)[number], string> = { hearts: '♥', diamonds: '♦', clubs: '♣', spades: '♠' };

const allCards = await getCollection('cards');
const heroCards = allCards
  .filter((c) => !c.data.back && c.data.suit && c.data.value)
  .map((c) => ({
    image: c.data.image as string,
    suit: c.data.suit as (typeof SUITS)[number],
    title: pickLocalized(c.data.title, lang),
  }));
const heroFirst = heroCards[0]?.image ?? '/media/selected-work.webp';

const worlds = Object.fromEntries(
  SUITS.map((suit) => [suit, { name: t(`worlds.${suit}.name`), symbol: SYMBOLS[suit] }]),
);
const quizUi = {
  right: t('hero.quiz_right'),
  wrong: t('hero.quiz_wrong'),
};
---

<section class="hero hero--bleed" id="deck" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true" data-hero-media>
    <img
      class="hero__stage is-front is-in"
      data-hero-a
      src={heroFirst}
      alt=""
      width="1200"
      height="1680"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <img
      class="hero__stage"
      data-hero-b
      src={heroFirst}
      alt=""
      width="1200"
      height="1680"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="page-shell hero__copy">
    <p class="hero__meta">{t('hero.meta')}</p>
    <h1 id="hero-title" class="hero__title" aria-label="Magister Cards">
      <span class="hero__wordmark" aria-hidden="true">
        <MagisterLogo width={880} height={407} />
      </span>
    </h1>
    <p class="hero__lead">
      {t('hero.lead_before')}<span class="hero__mark">{t('hero.lead_mark')}</span>{t('hero.lead_after')}
    </p>
    <p class="hero__body">{t('hero.body')}</p>
    <div class="hero__actions">
      <a class="btn btn-accent" href={deckHref}>{t('hero.buy')}</a>
      <a class="btn hero__btn-light" href="#worlds">{t('hero.play_cta')}</a>
    </div>
  </div>

  <aside class="hero-quiz" data-hero-quiz aria-label={t('hero.quiz_aria')}>
    <p class="hero-quiz__q" id="hero-quiz-q">{t('hero.quiz_question')}</p>
    <p class="hero-quiz__hint">{t('hero.quiz_hint')}</p>
    <div class="hero-quiz__options" role="group" aria-labelledby="hero-quiz-q">
      {
        SUITS.map((suit) => (
          <button class="hero-quiz__option" type="button" data-quiz-suit={suit} data-suit-color={suit}>
            <span class="hero-quiz__symbol" aria-hidden="true">{SYMBOLS[suit]}</span>
            <span>{worlds[suit].name}</span>
          </button>
        ))
      }
    </div>
    <p class="hero-quiz__result" data-quiz-result aria-live="polite" hidden></p>
    <button class="hero-quiz__next" type="button" data-quiz-next hidden>{t('hero.quiz_next')} →</button>
  </aside>
</section>

<script define:vars={{ heroCards, worlds, quizUi }}>
  const HERO_FADE_MS = 3000;
  const HERO_HOLD_MS = 5000;
  const cards = Array.isArray(heroCards) ? heroCards.filter((c) => c && c.image) : [];
  // Keep the server-rendered first card; shuffle the rest so suits can't be guessed from order.
  for (let i = cards.length - 1; i > 1; i--) {
    const j = 1 + Math.floor(Math.random() * i);
    [cards[i], cards[j]] = [cards[j], cards[i]];
  }
  const heroA = document.querySelector('[data-hero-a]');
  const heroB = document.querySelector('[data-hero-b]');
  const quiz = document.querySelector('[data-hero-quiz]');
  const quizResult = quiz?.querySelector('[data-quiz-result]');
  const quizNext = quiz?.querySelector('[data-quiz-next]');
  const quizOptions = quiz ? Array.from(quiz.querySelectorAll('[data-quiz-suit]')) : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let index = 0;
  let paused = false;
  let answered = false;
  let fading = false;
  /** @type {Array<() => void>} */
  let resumeWaiters = [];
  /** @type {null | (() => void)} */
  let skipHold = null;

  /** @param {number} ms */
  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  /** Hold that the "next card" button can cut short. @param {number} ms */
  function hold(ms) {
    return new Promise((resolve) => {
      const id = window.setTimeout(done, ms);
      function done() {
        window.clearTimeout(id);
        skipHold = null;
        resolve();
      }
      skipHold = done;
    });
  }

  function waitUntilResumed() {
    return paused ? new Promise((resolve) => resumeWaiters.push(resolve)) : Promise.resolve();
  }

  /** @param {boolean} value */
  function setPaused(value) {
    paused = value;
    if (!value) resumeWaiters.splice(0).forEach((resolve) => resolve());
  }

  /** @param {string} template @param {{ symbol: string, world: string, title: string }} vars */
  function fill(template, vars) {
    return template.replace(/\{(symbol|world|title)\}/g, (_, key) => vars[key] ?? '');
  }

  function resetQuiz() {
    answered = false;
    quizOptions.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.disabled = false;
      button.classList.remove('is-correct', 'is-wrong');
    });
    if (quizResult instanceof HTMLElement) {
      quizResult.hidden = true;
      quizResult.textContent = '';
    }
    if (quizNext instanceof HTMLElement) quizNext.hidden = true;
  }

  /** @param {string} suit */
  function answer(suit) {
    const card = cards[index];
    if (!card || answered) return;
    answered = true;
    setPaused(true);
    const correct = card.suit === suit;
    quizOptions.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const value = button.dataset.quizSuit;
      button.disabled = true;
      if (value === card.suit) button.classList.add('is-correct');
      else if (value === suit) button.classList.add('is-wrong');
    });
    const world = worlds[card.suit];
    if (quizResult instanceof HTMLElement) {
      quizResult.textContent = fill(correct ? quizUi.right : quizUi.wrong, {
        symbol: world?.symbol ?? '',
        world: world?.name ?? '',
        title: card.title,
      });
      quizResult.hidden = false;
    }
    if (quizNext instanceof HTMLButtonElement) {
      quizNext.hidden = false;
      quizNext.focus({ preventScroll: true });
    }
  }

  quizOptions.forEach((button) => {
    button.addEventListener('click', () => {
      if (button instanceof HTMLElement && button.dataset.quizSuit) answer(button.dataset.quizSuit);
    });
  });

  if (quiz instanceof HTMLElement) {
    quiz.addEventListener('pointerenter', () => setPaused(true));
    quiz.addEventListener('focusin', () => setPaused(true));
    quiz.addEventListener('pointerleave', () => {
      if (!answered) setPaused(false);
    });
    quiz.addEventListener('focusout', (event) => {
      if (!answered && !quiz.contains(/** @type {Node | null} */ (event.relatedTarget))) setPaused(false);
    });
  }

  /** @param {string} url @returns {Promise<void>} */
  function preloadHero(url) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = () => resolve();
      img.src = url;
    });
  }

  /** @param {HTMLImageElement} el */
  function clearHeroMotion(el) {
    el.getAnimations().forEach((a) => a.cancel());
    el.classList.remove('is-in', 'is-drift', 'is-front');
    el.style.transition = 'none';
    el.style.transform = '';
  }

  /** @param {HTMLImageElement} el */
  function startDrift(el) {
    el.getAnimations().forEach((a) => a.cancel());
    el.style.transform = 'scale(1.02) translate3d(0, 0, 0)';
    const xDir = Math.random() < 0.5 ? -1 : 1;
    const yDir = Math.random() < 0.5 ? -1 : 1;
    const x = xDir * (0.55 + Math.random() * 0.55);
    const y = yDir * (0.4 + Math.random() * 0.5);
    el.classList.add('is-drift');
    el.animate(
      [
        { transform: 'scale(1.02) translate3d(0, 0, 0)' },
        { transform: `scale(1.06) translate3d(${x}%, ${y}%, 0)` },
      ],
      { duration: 16000, easing: 'linear', fill: 'forwards' },
    );
  }

  /** @param {HTMLImageElement} el */
  function freezeDrift(el) {
    const endTransform = getComputedStyle(el).transform;
    el.getAnimations().forEach((a) => a.cancel());
    el.classList.remove('is-drift');
    el.style.transform = endTransform === 'none' ? 'scale(1.04)' : endTransform;
  }

  if (heroA instanceof HTMLImageElement && heroB instanceof HTMLImageElement && cards.length > 0) {
    if (reduceMotion) {
      heroA.classList.add('is-in', 'is-front');
      quizNext?.addEventListener('click', () => {
        index = (index + 1) % cards.length;
        heroA.src = cards[index].image;
        resetQuiz();
      });
    } else {
      let front = heroA;
      let back = heroB;

      const crossfade = async () => {
        fading = true;
        const nextIndex = (index + 1) % cards.length;
        await preloadHero(cards[nextIndex].image);
        index = nextIndex;
        resetQuiz();
        freezeDrift(front);
        clearHeroMotion(back);
        back.src = cards[nextIndex].image;
        back.style.transform = 'scale(1.02)';
        back.classList.add('is-front');
        front.classList.remove('is-front');
        void back.offsetWidth;
        requestAnimationFrame(() => {
          front.style.transition = 'opacity 3s linear';
          back.style.transition = 'opacity 3s linear';
          requestAnimationFrame(() => {
            back.classList.add('is-in');
            front.classList.remove('is-in');
          });
        });
        await wait(HERO_FADE_MS);
        clearHeroMotion(front);
        const prev = front;
        front = back;
        back = prev;
        front.style.transition = 'none';
        front.style.transform = '';
        front.getAnimations().forEach((a) => a.cancel());
        front.classList.add('is-in', 'is-front');
        fading = false;
      };

      const loop = async () => {
        for (;;) {
          preloadHero(cards[(index + 1) % cards.length].image);
          startDrift(front);
          await hold(HERO_HOLD_MS);
          await waitUntilResumed();
          await crossfade();
        }
      };

      quizNext?.addEventListener('click', () => {
        if (fading) return;
        setPaused(false);
        skipHold?.();
      });

      front.src = cards[0].image;
      clearHeroMotion(front);
      clearHeroMotion(back);
      front.classList.add('is-front');
      void front.offsetWidth;
      requestAnimationFrame(() => {
        front.style.transition = 'opacity 3s linear';
        requestAnimationFrame(() => front.classList.add('is-in'));
      });
      loop();
    }
  }
</script>

<style>
  .hero--bleed {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: clip;
    color: var(--white);
    background: #1a140c;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #1a140c;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    opacity: 0;
    transform: scale(1.02);
    transform-origin: 50% 28%;
    transition: opacity 3s linear;
    will-change: opacity, transform;
  }

  .hero__stage.is-front {
    z-index: 1;
  }

  .hero__stage.is-in {
    opacity: 1;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(12, 10, 6, 0.62) 0%, rgba(12, 10, 6, 0.28) 38%, transparent 70%),
      linear-gradient(0deg, rgba(12, 10, 6, 0.5) 0%, transparent 45%);
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    padding-block: clamp(7rem, 14vw, 10rem) clamp(4rem, 8vw, 6.5rem);
    max-width: 42rem;
    margin-inline: 0;
    animation: hero-copy-in 900ms ease both;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__meta {
    margin: 0;
    color: color-mix(in srgb, var(--white) 78%, #c8973a);
    font: 600 0.68rem/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 1.35rem 0 0;
    max-width: 22rem;
  }

  .hero__wordmark {
    display: block;
    line-height: 0;
    filter: drop-shadow(0 0.45rem 1.1rem rgba(0, 0, 0, 0.45));
  }

  .hero__wordmark :global(.magister-logo) {
    width: min(100%, 20rem);
    height: auto;
    max-width: none;
  }

  .hero__lead {
    margin: 1.75rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.45rem, 2.4vw, 2.05rem);
    font-weight: 400;
    line-height: 1.28;
    max-width: 28rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__mark {
    color: color-mix(in srgb, var(--white) 88%, #c8973a);
  }

  .hero__body {
    margin: 1rem 0 0;
    max-width: 28rem;
    color: color-mix(in srgb, var(--white) 84%, transparent);
    line-height: 1.7;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__btn-light {
    border-color: color-mix(in srgb, var(--white) 70%, transparent);
    color: var(--white);
    background: transparent;
  }

  .hero__btn-light:hover {
    background: var(--white);
    color: var(--ink);
  }

  .hero--bleed .btn-accent {
    border-color: var(--accent);
  }

  .hero-quiz {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3.5rem);
    bottom: clamp(2rem, 6vw, 4.5rem);
    z-index: 3;
    display: grid;
    gap: 0.65rem;
    width: min(22rem, 34vw);
    padding: 1.1rem 1.15rem 1.2rem;
    border: 1px solid rgba(243, 240, 232, 0.22);
    background: rgba(14, 11, 7, 0.62);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--white);
    animation: hero-copy-in 900ms 400ms ease both;
  }

  .hero-quiz__q {
    margin: 0;
    font-family: var(--display);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .hero-quiz__hint {
    margin: -0.25rem 0 0.15rem;
    color: rgba(243, 240, 232, 0.66);
    font-size: 0.85rem;
  }

  .hero-quiz__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .hero-quiz__option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid rgba(243, 240, 232, 0.28);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: 500 0.78rem/1.2 var(--sans);
    text-align: left;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .hero-quiz__option:hover:not(:disabled),
  .hero-quiz__option:focus-visible {
    border-color: rgba(243, 240, 232, 0.75);
    background: rgba(243, 240, 232, 0.08);
  }

  .hero-quiz__option:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .hero-quiz__symbol {
    font-size: 1.1rem;
    line-height: 1;
  }

  .hero-quiz__option[data-suit-color='hearts'] .hero-quiz__symbol,
  .hero-quiz__option[data-suit-color='diamonds'] .hero-quiz__symbol {
    color: #e0675a;
  }

  .hero-quiz__option.is-correct {
    opacity: 1;
    border-color: #c8973a;
    background: rgba(200, 151, 58, 0.22);
  }

  .hero-quiz__option.is-wrong {
    opacity: 1;
    border-color: rgba(224, 103, 90, 0.8);
    text-decoration: line-through;
  }

  .hero-quiz__result {
    margin: 0.15rem 0 0;
    line-height: 1.45;
  }

  .hero-quiz__result[hidden],
  .hero-quiz__next[hidden] {
    display: none;
  }

  .hero-quiz__next {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: #e3bf73;
    cursor: pointer;
    font: 600 0.72rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage,
    .hero__copy,
    .hero-quiz {
      animation: none !important;
      transition: none !important;
    }

    .hero__stage {
      opacity: 1;
      transform: scale(1.02);
    }
  }

  @media (max-width: 900px) {
    .hero__copy {
      padding-bottom: 1.5rem;
    }

    .hero-quiz {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: 0 var(--gutter, 1.25rem) calc(2rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 720px) {
    .hero__stage {
      object-position: center 22%;
    }

    .hero__wordmark :global(.magister-logo) {
      width: min(100%, 16rem);
    }
  }
</style>
