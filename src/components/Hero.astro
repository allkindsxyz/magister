---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="deck" aria-labelledby="hero-title">
  <div class="page-shell hero-grid">
    <div class="hero-copy">
      <p class="section-label hero-meta">{t('hero.meta')}</p>
      <h1 id="hero-title" class="hero-title" aria-label="Magister Cards">
        <span class="hero-title__wordmark" aria-hidden="true">
          <MagisterLogo width={880} height={407} level />
        </span>
      </h1>
      <p class="hero-lead">
        {t('hero.lead_before')}<span class="hero-lead__mark">{t('hero.lead_mark')}</span>{t('hero.lead_after')}
      </p>
      <p class="hero-body">{t('hero.body')}</p>

      <div class="hero-actions">
        <a class="btn" href="#fifty-four">{t('hero.explore')}</a>
        <a class="btn btn-accent" href="#spiel">
          <span class="btn-event-mark" aria-hidden="true">✦</span>
          {t('hero.meet')}
        </a>
      </div>
    </div>

    <figure class="hero-pack">
      <img
        src="/media/pack.png"
        alt={t('hero.pack_alt')}
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    padding-block: clamp(8rem, 12vw, 11rem) clamp(5rem, 8vw, 8rem);
    overflow-x: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 36rem) minmax(20rem, 1fr);
    align-items: center;
    gap: 3rem 1.5rem;
    min-width: 0;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero-meta {
    color: var(--accent);
  }

  .hero-title {
    margin-top: 1.6rem;
    max-width: min(100%, 24rem);
  }

  .hero-title__wordmark {
    display: block;
    line-height: 0;
    padding-block: 0.35rem 0.15rem;
  }

  .hero-title__wordmark :global(.magister-logo) {
    width: min(100%, 22rem);
    height: auto;
    max-width: none;
    filter: drop-shadow(0 0.35rem 0.85rem rgba(42, 68, 132, 0.14));
  }

  .hero-lead {
    max-width: 42rem;
    margin-top: 1.85rem;
    font-family: var(--display);
    font-size: clamp(1.35rem, 1.85vw, 1.85rem);
    line-height: 1.32;
  }

  .hero-lead__mark {
    font-weight: 600;
  }

  .hero-body {
    max-width: 40rem;
    margin-top: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .hero-pack {
    z-index: 1;
    position: relative;
    /* Source canvas is 1536×1024; the box itself is 676×956 at (426, 34). */
    width: min(100%, 20rem);
    aspect-ratio: 676 / 956;
    margin: 0;
    justify-self: center;
    align-self: center;
  }

  .hero-pack img {
    position: absolute;
    width: calc(1536 / 676 * 100%);
    max-width: none;
    height: auto;
    left: calc(-426 / 676 * 100%);
    top: calc(-34 / 956 * 100%);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: 7.5rem;
    }

    .hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .hero-copy {
      display: contents;
    }

    .hero-meta {
      order: 1;
    }

    .hero-title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .hero-pack {
      order: 2;
      width: min(78vw, 24rem);
      align-self: center;
      margin-top: 1.5rem;
    }

    .hero-lead {
      order: 3;
    }

    .hero-body {
      order: 4;
    }

    .hero-actions {
      order: 5;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 6.75rem;
    }

    .hero-pack {
      width: min(86vw, 22rem);
      margin-top: 1.25rem;
    }

    .hero-lead {
      margin-top: 2.25rem;
    }

    .hero-body {
      order: 4;
    }

    .hero-actions {
      order: 5;
      display: grid;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }
  }

</style>
