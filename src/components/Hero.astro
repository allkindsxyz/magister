---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';
import MagisterLogo from './MagisterLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allCards = await getCollection('cards');
const cards = [
  ...allCards.filter((card) => card.data.featured),
  ...allCards.filter((card) => !card.data.featured),
].slice(0, 6);
const backCount = Math.max(0, cards.length - 1);
---

<section class="hero" id="deck" aria-labelledby="hero-title">
  <div class="page-shell hero-grid">
    <div class="hero-copy">
      <p class="section-label hero-meta">{t('hero.meta')}</p>
      <h1 id="hero-title" class="hero-title" aria-label="Magister Cards">
        <span class="hero-title__wordmark" aria-hidden="true">
          <MagisterLogo width={880} height={407} level />
        </span>
      </h1>
      <p class="hero-lead">
        {t('hero.lead_before')}<span class="hero-lead__mark">{t('hero.lead_mark')}</span>{t('hero.lead_after')}
      </p>
      <p class="hero-body">{t('hero.body')}</p>

      <div class="hero-actions">
        <a class="btn" href="#fifty-four">{t('hero.explore')}</a>
        <a class="btn btn-accent" href="#spiel">
          <span class="btn-event-mark" aria-hidden="true">✦</span>
          {t('hero.meet')}
        </a>
      </div>
    </div>

    <div class="hero-deck">
      <div class="deck-stack" aria-hidden="true">
        {Array.from({ length: backCount }).map((_, index) => {
          const card = cards[index + 1];
          return (
            <span
              class="deck-card deck-card-back"
              style={`
                --stack-offset: ${(index + 1) * 8}px;
                --stack-rotate: ${(index + 1) * -2.4 + 1.6}deg;
                --stack-z: ${backCount - index};
              `}
            >
              {card && <img src={card.data.image} alt="" loading="eager" decoding="async" />}
            </span>
          );
        })}
      </div>

      <button
        class="deck-card deck-card-front"
        id="deck-front"
        type="button"
        aria-label={t('hero.deck_next')}
        disabled={cards.length < 2}
      >
        <img
          id="deck-front-image"
          src={cards[0]?.data.image}
          alt={cards[0]?.data.title[lang]}
          width="920"
          height="1316"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          draggable="false"
        />
      </button>
    </div>
  </div>
</section>

<script
  id="hero-card-data"
  type="application/json"
  set:html={JSON.stringify(cards.map((card) => ({
    image: card.data.image,
    title: card.data.title[lang],
  })))}
/>

<style>
  .hero {
    min-height: 100svh;
    padding-block: clamp(8rem, 12vw, 11rem) clamp(5rem, 8vw, 8rem);
    overflow-x: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: 3rem 2.5rem;
    min-width: 0;
    width: 100%;
  }

  .hero-copy {
    grid-column: 1 / 8;
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero-meta {
    color: var(--accent);
  }

  .hero-title {
    margin-top: 1.6rem;
    max-width: min(100%, 24rem);
  }

  .hero-title__wordmark {
    display: block;
    line-height: 0;
    padding-block: 0.35rem 0.15rem;
  }

  .hero-title__wordmark :global(.magister-logo) {
    width: min(100%, 22rem);
    height: auto;
    max-width: none;
    filter: drop-shadow(0 0.35rem 0.85rem rgba(42, 68, 132, 0.14));
  }

  .hero-lead {
    max-width: 42rem;
    margin-top: 1.85rem;
    font-family: var(--display);
    font-size: clamp(1.35rem, 1.85vw, 1.85rem);
    line-height: 1.32;
  }

  .hero-lead__mark {
    color: color-mix(in srgb, var(--brand-blue) 88%, var(--ink));
    font-family: var(--sans);
    font-size: 0.94em;
    font-weight: 600;
    letter-spacing: 0.03em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.12em;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--brand-blue) 38%, transparent) 0,
      color-mix(in srgb, var(--brand-blue) 38%, transparent) 0.16em,
      transparent 0.16em
    );
  }

  .hero-body {
    max-width: 40rem;
    margin-top: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .hero-deck {
    grid-column: 8 / 13;
    grid-row: 1;
    position: relative;
    z-index: 1;
    width: min(72%, 19.8rem);
    aspect-ratio: 93 / 133;
    justify-self: end;
    align-self: center;
    margin-right: 4%;
  }

  .deck-card {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-radius: 0.35rem;
    background: var(--white);
    box-shadow: 0 1.5rem 4rem rgba(23, 23, 20, 0.18);
    backface-visibility: hidden;
  }

  .deck-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .deck-card-back {
    position: absolute;
    inset: 0;
    z-index: var(--stack-z);
    transform: translateX(var(--stack-offset)) rotate(var(--stack-rotate));
    pointer-events: none;
  }

  .deck-card-back:nth-child(1) { filter: brightness(0.98); }
  .deck-card-back:nth-child(2) { filter: brightness(0.95); }
  .deck-card-back:nth-child(3) { filter: brightness(0.92); }
  .deck-card-back:nth-child(4) { filter: brightness(0.89); }
  .deck-card-back:nth-child(5) { filter: brightness(0.86); }

  .deck-card-front {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    padding: 0;
    transform: rotate(-1deg);
    cursor: pointer;
  }

  .deck-card-front:hover:not(.is-busy) {
    box-shadow: 0 2rem 5rem rgba(23, 23, 20, 0.24);
  }

  .deck-card-front:disabled {
    cursor: default;
  }

  .deck-card-front.is-busy {
    pointer-events: none;
  }

  .deck-card-front.anim-exit-next {
    animation: heroExitNext 440ms cubic-bezier(0.45, 0, 0.55, 1) forwards;
  }

  .deck-card-front.anim-exit-prev {
    animation: heroExitPrev 440ms cubic-bezier(0.45, 0, 0.55, 1) forwards;
  }

  .deck-card-front.swap-phase {
    animation: none !important;
    opacity: 0 !important;
    transform: rotate(-1deg) !important;
  }

  @keyframes heroExitNext {
    from {
      transform: rotate(-1deg) translateY(0) scale(1);
      opacity: 1;
    }
    to {
      transform: rotate(-2deg) translateY(112%) scale(0.93);
      opacity: 0;
    }
  }

  @keyframes heroExitPrev {
    from {
      transform: rotate(-1deg) translateY(0) scale(1);
      opacity: 1;
    }
    to {
      transform: rotate(2deg) translateY(-112%) scale(0.93);
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: 7.5rem;
    }

    .hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .hero-copy {
      display: contents;
    }

    .hero-meta {
      order: 1;
    }

    .hero-title {
      order: 2;
    }

    .hero-lead {
      order: 3;
    }

    .hero-body {
      order: 4;
    }

    .hero-actions {
      order: 5;
    }

    .hero-deck {
      order: 6;
      width: min(40vw, 17.6rem);
      align-self: center;
      margin-right: 0;
      margin-top: 2.5rem;
      overflow: hidden;
      contain: layout paint;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 6.75rem;
    }

    .hero-title {
      margin-top: 1rem;
      max-width: 100%;
    }

    .hero-title__wordmark :global(.magister-logo) {
      width: min(100%, 18.5rem);
    }

    .hero-deck {
      order: 3;
      width: min(50vw, 14.7rem);
      margin-top: 2.5rem;
    }

    .hero-lead {
      order: 4;
      margin-top: 3rem;
    }

    .hero-body {
      order: 5;
    }

    .hero-actions {
      order: 6;
      display: grid;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-card-front.anim-exit-next,
    .deck-card-front.anim-exit-prev {
      animation-duration: 1ms;
    }
  }
</style>

<script>
  (() => {
    const data = document.getElementById('hero-card-data');
    const front = document.getElementById('deck-front') as HTMLButtonElement | null;
    const frontImage = document.getElementById('deck-front-image') as HTMLImageElement | null;
    if (!data || !front || !frontImage) return;

    const cards: Array<{ image: string; title: string }> = JSON.parse(data.textContent || '[]');
    const backCards = Array.from(document.querySelectorAll<HTMLElement>('.deck-card-back'));
    if (cards.length < 2) return;

    let current = 0;
    let busy = false;
    let touchStartX = 0;
    let skipClick = false;

    function syncBackCards() {
      backCards.forEach((element, index) => {
        const image = element.querySelector('img');
        const card = cards[(current + index + 1) % cards.length];
        if (!image || !card) return;
        image.src = card.image;
        image.alt = '';
      });
    }

    function waitForAnimation(element: HTMLElement, animationName: string) {
      return new Promise<void>((resolve) => {
        let finished = false;
        const finish = () => {
          if (finished) return;
          finished = true;
          element.removeEventListener('animationend', onEnd);
          window.clearTimeout(timeout);
          resolve();
        };
        const onEnd = (event: AnimationEvent) => {
          if (event.target === element && event.animationName.includes(animationName)) finish();
        };
        const timeout = window.setTimeout(finish, 500);
        element.addEventListener('animationend', onEnd);
      });
    }

    async function show(index: number, direction: 'next' | 'previous') {
      if (busy) return;
      busy = true;
      front.classList.add('is-busy');
      const exitClass = direction === 'next' ? 'anim-exit-next' : 'anim-exit-prev';
      const animationName = direction === 'next' ? 'heroExitNext' : 'heroExitPrev';
      front.classList.add(exitClass);
      await waitForAnimation(front, animationName);

      front.classList.remove(exitClass);
      front.classList.add('swap-phase');
      current = (index + cards.length) % cards.length;
      frontImage.src = cards[current].image;
      frontImage.alt = cards[current].title;

      try {
        await frontImage.decode();
      } catch {
        // The browser can still display the image when decode rejects.
      }

      await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
      front.classList.remove('swap-phase');
      syncBackCards();
      front.classList.remove('is-busy');
      busy = false;
    }

    const next = () => void show(current + 1, 'next');
    const previous = () => void show(current - 1, 'previous');

    front.addEventListener('click', () => {
      if (!skipClick) next();
    });

    front.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0].clientX;
    }, { passive: true });

    front.addEventListener('touchend', (event) => {
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) < 48) return;
      skipClick = true;
      window.setTimeout(() => { skipClick = false; }, 320);
      if (distance < 0) next();
      else previous();
    }, { passive: true });

    document.addEventListener('keydown', (event) => {
      const hero = document.querySelector<HTMLElement>('.hero');
      const rect = hero?.getBoundingClientRect();
      if (!rect || rect.top >= window.innerHeight || rect.bottom <= 0 || busy) return;
      if (event.key === 'ArrowRight') next();
      if (event.key === 'ArrowLeft') previous();
    });

    syncBackCards();
  })();
</script>
