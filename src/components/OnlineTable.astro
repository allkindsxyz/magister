---
import type { Lang } from '../i18n/utils';
import { onlineCopy } from '../i18n/onlineCopy';
import { getSiteUrl } from '../lib/site';

interface Props {
  lang: Lang;
  backLabel: string;
  initialRoom: string | null;
}

const { lang, backLabel, initialRoom } = Astro.props;
const copy = onlineCopy[lang];
---

<section class="mag-online" data-online-root data-lang={lang} data-site-origin={getSiteUrl()}>
  <div class="mag-online-lobby" data-online-lobby data-lobby-mode="create">
    <p class="mag-online-lobby-intro" data-online-lobby-intro>{copy.new_game_hint}</p>
    <label class="mag-online-field">
      <span>{copy.your_name}</span>
      <input type="text" data-online-name maxlength="24" autocomplete="nickname" />
    </label>
    <button class="btn btn-accent mag-online-create" type="button" data-online-create>
      {copy.create}
    </button>
    <button class="btn btn-accent mag-online-join" type="button" data-online-join hidden>
      {copy.join_table}
    </button>
    <p class="mag-online-hint" data-online-hint hidden>{copy.join_hint}</p>
    <p class="mag-online-status" data-online-status hidden>{copy.need_players}</p>
    <p class="mag-online-code" hidden>
      <span>{copy.room_code}</span>
      <strong data-online-room-code>—</strong>
    </p>
    <button class="btn fw-title-timed" type="button" data-online-copy hidden>
      {copy.copy_link}
    </button>
  </div>

  <div class="mag-online-table" data-online-table hidden>
    <div class="mag-online-fly-layer" data-online-fly-layer aria-hidden="true"></div>

  <span class="mag-online-turn u-sr-only" data-online-turn aria-live="polite"></span>

    <section class="mag-online-opponents" data-online-arena data-opp-count="0">
      <div class="mag-online-player" data-online-opp="0" data-online-left>
        <p class="mag-online-seat-name" data-seat-name>
          <span class="mag-online-online-dot" data-seat-online hidden aria-hidden="true"></span>
          <span data-seat-name-text>—</span>
          <button
            type="button"
            class="mag-online-bot-remove"
            data-seat-remove
            hidden
            aria-label={copy.remove_bot}
          >
            <span aria-hidden="true">×</span>
          </button>
        </p>
        <div class="mag-online-mini-stack" data-seat-stack>
          <div class="mag-online-opp-hand" data-seat-cards role="img" aria-label=""></div>
        </div>
      </div>
      <div class="mag-online-player" data-online-opp="1" data-online-center>
        <p class="mag-online-seat-name" data-seat-name>
          <span class="mag-online-online-dot" data-seat-online hidden aria-hidden="true"></span>
          <span data-seat-name-text>—</span>
          <button
            type="button"
            class="mag-online-bot-remove"
            data-seat-remove
            hidden
            aria-label={copy.remove_bot}
          >
            <span aria-hidden="true">×</span>
          </button>
        </p>
        <div class="mag-online-mini-stack" data-seat-stack>
          <div class="mag-online-opp-hand" data-seat-cards role="img" aria-label=""></div>
        </div>
      </div>
      <div class="mag-online-player" data-online-opp="2" data-online-right>
        <p class="mag-online-seat-name" data-seat-name>
          <span class="mag-online-online-dot" data-seat-online hidden aria-hidden="true"></span>
          <span data-seat-name-text>—</span>
          <button
            type="button"
            class="mag-online-bot-remove"
            data-seat-remove
            hidden
            aria-label={copy.remove_bot}
          >
            <span aria-hidden="true">×</span>
          </button>
        </p>
        <div class="mag-online-mini-stack" data-seat-stack>
          <div class="mag-online-opp-hand" data-seat-cards role="img" aria-label=""></div>
        </div>
      </div>
    </section>

    <section class="mag-online-table-zone">
      <div class="mag-online-mid mag-online-mid--deck-centered" data-online-mid>
        <div
          class="mag-online-discard-shell"
          data-online-discard-open
          role="button"
          tabindex="0"
          aria-label={copy.discard_zoom_open}
          aria-expanded="false"
        >
          <div class="mag-online-discard" data-online-discard></div>
        </div>
        <div class="mag-online-lobby-field" data-online-lobby-field hidden>
          <fieldset class="mag-online-hints-mode mag-online-hints-mode--table" data-online-hints-mode>
            <legend class="mag-online-hints-mode__label">{copy.hints_mode_label}</legend>
            <div class="mag-online-hints-segment" role="radiogroup" aria-label={copy.hints_mode_label}>
              <label class="mag-online-hints-segment__opt">
                <input type="radio" name="online-hints" value="on" checked data-online-hints-value="on" />
                <span>{copy.hints_with}</span>
              </label>
              <label class="mag-online-hints-segment__opt">
                <input type="radio" name="online-hints" value="off" data-online-hints-value="off" />
                <span>{copy.hints_without}</span>
              </label>
            </div>
          </fieldset>
          <div class="mag-online-lobby-actions" data-online-lobby-actions>
            <button class="btn btn-accent mag-online-lobby-field__btn" type="button" data-online-lobby-copy>
              {copy.menu_copy}
            </button>
            <button class="btn btn-accent mag-online-lobby-field__btn" type="button" data-online-lobby-add-bot>
              {copy.menu_add_bot}
            </button>
            <button class="btn btn-accent mag-online-lobby-field__btn" type="button" data-online-lobby-start hidden>
              {copy.start_game}
            </button>
          </div>
        </div>
        <button
          class="mag-online-deck-hit"
          type="button"
          data-online-deck
          aria-label={copy.draw}
        >
          <img src="/media/card-back-600.webp" alt="" width={220} height={308} decoding="async" />
        </button>
        <p class="mag-online-table-prompt" data-online-table-prompt hidden></p>
      </div>
    </section>

    <div class="mag-online-suit-picker" data-online-suit-picker hidden>
      <p class="mag-online-suit-kicker">{copy.choose_suit}</p>
      <div class="mag-online-suit-row">
        <button type="button" class="mag-online-suit-pick" data-suit="hearts" aria-label={copy.suit_hearts}>
          <span class="mag-online-suit-glyph mag-online-suit-glyph--hearts" aria-hidden="true">♥</span>
        </button>
        <button type="button" class="mag-online-suit-pick" data-suit="diamonds" aria-label={copy.suit_diamonds}>
          <span class="mag-online-suit-glyph mag-online-suit-glyph--diamonds" aria-hidden="true">♦</span>
        </button>
        <button type="button" class="mag-online-suit-pick" data-suit="clubs" aria-label={copy.suit_clubs}>
          <span class="mag-online-suit-glyph mag-online-suit-glyph--clubs" aria-hidden="true">♣</span>
        </button>
        <button type="button" class="mag-online-suit-pick" data-suit="spades" aria-label={copy.suit_spades}>
          <span class="mag-online-suit-glyph mag-online-suit-glyph--spades" aria-hidden="true">♠</span>
        </button>
      </div>
    </div>

    <footer class="mag-online-footer">
      <div class="mag-online-hand-shell" data-online-hand-shell>
        <p class="mag-online-hand-name" data-online-hand-name>
          <span class="mag-online-online-dot" data-hand-online hidden aria-hidden="true"></span>
          <span data-hand-name-text></span>
        </p>
        <div class="mag-online-hand-frame" data-online-hand-frame>
          <div class="mag-online-hand" data-online-hand role="list"></div>
        </div>
      </div>
    </footer>

    <div
      class="mag-online-discard-zoom"
      data-online-discard-zoom
      role="dialog"
      aria-modal="true"
      aria-label={copy.discard_zoom_open}
      hidden
    >
      <button class="mag-online-discard-zoom__close" type="button" data-online-discard-zoom-close>
        {copy.discard_zoom_close}
      </button>
      <button
        class="mag-online-discard-zoom__sheet"
        type="button"
        data-online-discard-zoom-sheet
        aria-label={copy.discard_zoom_close}
      >
        <img data-online-discard-zoom-img alt="" decoding="async" />
      </button>
    </div>

    <div class="mag-online-join-alert" data-online-join-alert hidden>
      <div class="mag-online-join-alert-card">
        <p class="mag-online-join-alert-title" data-online-join-alert-title></p>
        <p class="mag-online-join-alert-hint" data-online-join-alert-hint>{copy.mid_game_join_hint}</p>
        <p class="mag-online-join-alert-wait" data-online-join-alert-wait hidden></p>
        <div class="mag-online-join-alert-actions" data-online-join-alert-actions>
          <button type="button" class="btn btn-accent" data-online-join-restart>
            {copy.mid_game_join_restart}
          </button>
          <button type="button" class="btn fw-title-timed" data-online-join-finish>
            {copy.mid_game_join_wait}
          </button>
        </div>
      </div>
    </div>

    <div class="mag-online-end" data-online-end hidden>
      <div class="mag-online-end-fireworks" data-online-end-fireworks aria-hidden="true" hidden></div>
      <div class="mag-online-end-card">
        <p class="mag-online-end-kicker" data-online-end-kicker>{copy.game_over}</p>
        <p class="mag-online-end-title" data-online-end-title></p>
        <p class="mag-online-end-wins" data-online-end-wins hidden></p>
        <div class="mag-online-end-actions">
          <button type="button" class="btn btn-accent" data-online-rematch>
            {copy.play_again}
          </button>
          <button type="button" class="btn fw-title-timed" data-online-new-game>
            {copy.new_game}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountOnlineTable, parseRoomFromLocation } from '../scripts/online-table';
  import { onlineCopy } from '../i18n/onlineCopy';
  import type { Lang } from '../i18n/utils';

  function boot(): void {
    const root = document.querySelector<HTMLElement>('[data-online-root]');
    const lang = (root?.dataset.lang ?? 'ru') as Lang;
    const initial = parseRoomFromLocation();
    mountOnlineTable(root, { lang, copy: onlineCopy[lang], initialRoom: initial });
  }

  boot();
</script>

<style is:global>
  .mag-app-panel--online {
    display: flex;
    flex-direction: column;
    background: #070b12;
    color: #f2e9d8;
  }

  .mag-app-panel--online .mag-online {
    flex: 1 1 auto;
    min-height: 0;
  }

  .mag-online {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-family: Inter, 'Manrope', system-ui, sans-serif;
  }

  .mag-online .u-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mag-online-lobby {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: max(1rem, env(safe-area-inset-top)) 1rem 1.5rem;
    text-align: center;
  }

  .mag-online-lobby-intro {
    max-width: 18rem;
    margin: 0 0 0.15rem;
    color: #e8dfd0;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .mag-online-lobby[data-lobby-mode='create'] .mag-online-hint,
  .mag-online-lobby[data-lobby-mode='create'] .mag-online-status,
  .mag-online-lobby[data-lobby-mode='create'] .mag-online-code {
    display: none !important;
  }

  .mag-online-lobby[data-lobby-mode='invite'] .mag-online-hint,
  .mag-online-lobby[data-lobby-mode='invite'] .mag-online-status,
  .mag-online-lobby[data-lobby-mode='invite'] .mag-online-code {
    display: none !important;
  }

  .mag-online-hints-mode {
    width: min(100%, 18rem);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    text-align: left;
  }

  .mag-online-hints-mode__label {
    margin: 0 0 0.4rem;
    padding: 0;
    font-size: 0.88rem;
    color: #e8dfd0;
    font-weight: normal;
  }

  .mag-online-hints-segment {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem;
    padding: 0.22rem;
    border: 1px solid rgba(199, 163, 106, 0.45);
    border-radius: 0.35rem;
    background: rgba(17, 27, 43, 0.88);
  }

  .mag-online-hints-segment__opt {
    position: relative;
    margin: 0;
    cursor: pointer;
  }

  .mag-online-hints-segment__opt input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .mag-online-hints-segment__opt span {
    display: block;
    padding: 0.62rem 0.5rem;
    font-size: 0.74rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    color: #aaa9b5;
    border-radius: 0.25rem;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
  }

  @media (min-width: 640px) {
    .mag-online-hints-segment {
      gap: 0.35rem;
      padding: 0.3rem;
    }

    .mag-online-hints-segment__opt span {
      padding: 0.68rem 0.85rem;
      font-size: 0.8rem;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
  }

  .mag-online-hints-segment__opt input:checked + span {
    background: rgba(201, 169, 108, 0.22);
    color: #ecd09b;
    box-shadow: inset 0 0 0 1px rgba(201, 169, 108, 0.45);
  }

  .mag-online-hints-segment__opt input:focus-visible + span {
    outline: 2px solid #ecd09b;
    outline-offset: 1px;
  }

  .mag-online-lobby[hidden],
  .mag-online-table[hidden] {
    display: none !important;
  }

  .mag-online-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: min(100%, 18rem);
    text-align: left;
    font-size: 0.88rem;
  }

  .mag-online-field input {
    min-height: 2.75rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid rgba(199, 163, 106, 0.45);
    background: #111b2b;
    color: #f0e7d5;
    font: inherit;
  }

  .mag-online-hint {
    max-width: 20rem;
    margin: 0;
    color: #aaa9b5;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .mag-online-table {
    --online-motion: 1.5;
    --online-turn-green: #6fb86f;
    --online-felt: #101a27;
    --online-gold: #c9a96c;
    --online-gold2: #ecd6a6;
    --online-card-w: clamp(4.75rem, 22vw, 7.25rem);
    --online-card-h: calc(var(--online-card-w) * 1.4);
    --online-center-w: calc(var(--online-card-w) * 2);
    --online-center-h: calc(var(--online-card-h) * 2);
    --online-deck-w: clamp(3.4rem, 14vw, 4.4rem);
    --online-deck-h: calc(var(--online-deck-w) * 1.4);
    position: relative;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding:
      max(0.35rem, env(safe-area-inset-top))
      max(0.85rem, env(safe-area-inset-right))
      max(0.65rem, env(safe-area-inset-bottom))
      max(0.85rem, env(safe-area-inset-left));
    background:
      radial-gradient(ellipse at 50% 43%, rgba(44, 76, 99, 0.27), transparent 46%),
      radial-gradient(ellipse at 50% 0%, rgba(183, 145, 83, 0.12), transparent 35%),
      linear-gradient(180deg, #101a28 0%, #0c1521 47%, #080e18 100%);
  }

  .mag-online-table::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.17;
    background-image: radial-gradient(#d5bc8b 0.55px, transparent 0.55px);
    background-size: 17px 17px;
    mask-image: linear-gradient(180deg, black, transparent 82%);
  }

  @media (min-width: 768px) {
    .mag-app-panel--online .mag-online-table {
      width: min(100%, 50rem);
      max-width: 50rem;
      margin-inline: auto;
      --online-card-w: clamp(4.85rem, 5.8vw, 6.15rem);
      --online-deck-w: clamp(3.45rem, 4.2vw, 4.55rem);
      --online-center-w: calc(var(--online-card-w) * 1.85);
      --online-center-h: calc(var(--online-card-h) * 1.85);
    }

    .mag-app-panel--online .mag-online-opponents {
      max-width: min(100%, 46rem);
      margin-bottom: 0.65rem;
    }

    .mag-app-panel--online .mag-online-opponents[data-opp-count='1'] {
      max-width: 14rem;
    }

    .mag-app-panel--online .mag-online-opponents[data-opp-count='2'] {
      max-width: min(100%, 38rem);
      column-gap: clamp(2.5rem, 12vw, 8rem);
    }

    .mag-app-panel--online .mag-online-table-zone {
      flex: 0 1 auto;
      min-height: clamp(12rem, 28vh, 18rem);
      padding-bottom: 0.45rem;
    }

    .mag-app-panel--online .mag-online-mid {
      max-width: min(100%, 44rem);
    }

    .mag-app-panel--online .mag-online-table-zone::before {
      width: 88%;
      height: 82%;
    }
  }

  .mag-online-fly-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 80;
  }

  .mag-online-fly-card {
    position: fixed;
    left: 0;
    top: 0;
    width: var(--fly-w, var(--online-card-w));
    height: var(--fly-h, var(--online-card-h));
    border-radius: var(--fly-r, 0.45rem);
    box-shadow: 0 0.65rem 1.5rem rgba(0, 0, 0, 0.55);
    object-fit: cover;
    transform-origin: top left;
    will-change: transform, opacity;
    z-index: 81;
  }

  .mag-online-fly-draw {
    position: fixed;
    z-index: 62;
    perspective: 1000px;
    transform-origin: top left;
    pointer-events: none;
  }

  .mag-online-fly-draw__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(0deg);
    will-change: transform;
  }

  .mag-online-fly-draw__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0.4rem;
    object-fit: cover;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 0.55rem 1.35rem rgba(0, 0, 0, 0.5);
  }

  .mag-online-fly-draw__face--front {
    transform: rotateY(180deg);
  }

  .mag-online-fly-starter {
    position: fixed;
    z-index: 63;
    perspective: 1200px;
    pointer-events: none;
    transform-origin: top left;
    will-change: transform;
  }

  .mag-online-fly-starter--deal {
    filter: drop-shadow(0 0.85rem 1.65rem rgba(0, 0, 0, 0.62));
  }

  .mag-online-fly-starter__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(0deg);
    transition: none;
    will-change: transform;
  }

  .mag-online-fly-starter.is-at-center .mag-online-fly-starter__flip {
    transition: transform 350ms cubic-bezier(0.34, 1.22, 0.42, 1);
  }

  .mag-online-fly-starter__flip.is-revealed {
    transform: rotateY(180deg) scale(1.03);
  }

  .mag-online-fly-starter__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0.45rem;
    object-fit: cover;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 0.65rem 1.5rem rgba(0, 0, 0, 0.55);
  }

  .mag-online-fly-starter__face--front {
    transform: rotateY(180deg);
  }

  .mag-online-deck-hit.is-starter-launch {
    animation: mag-online-deck-starter-kick 0.62s cubic-bezier(0.34, 1.05, 0.48, 1);
  }

  @keyframes mag-online-deck-starter-kick {
    0%,
    100% {
      transform: translateX(0) scale(1);
      filter: brightness(1);
    }
    38% {
      transform: translateX(5px) scale(0.96);
      filter: brightness(0.92);
    }
    68% {
      transform: translateX(-2px) scale(1.02);
      filter: brightness(1.05);
    }
  }

  .mag-online-discard-shell.is-starter-reveal .mag-online-discard {
    animation: mag-online-starter-pop 0.52s cubic-bezier(0.34, 1.15, 0.48, 1);
  }

  @keyframes mag-online-starter-pop {
    0% {
      transform: scale(1);
      filter: brightness(1);
    }
    42% {
      transform: scale(1.1);
      filter: brightness(1.18);
      box-shadow:
        0 0.65rem 1.4rem rgba(0, 0, 0, 0.5),
        0 0 0 3px rgba(236, 208, 155, 0.42);
    }
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
  }

  @keyframes mag-online-turn-pop {
    0% {
      transform: scale(0.96);
      opacity: 0.75;
    }
    40% {
      transform: scale(1.03);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes mag-online-seat-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(236, 208, 155, 0);
    }
    50% {
      box-shadow: 0 0 0 0.28rem rgba(236, 208, 155, 0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mag-online-table {
      --online-motion: 0;
    }
    .mag-online-fly-card,
    .mag-online-fly-draw,
    .mag-online-mini-stack.is-active,
    .mag-online-deck-hit.is-active,
    .mag-online-hand-card,
    .mag-online-deck-hit {
      animation: none !important;
      transition: none !important;
    }
  }

  .mag-online-opponents {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(0.35rem, 2.5vw, 0.75rem);
    margin-bottom: 0.45rem;
    width: 100%;
    max-width: min(100%, 28rem);
    margin-inline: auto;
    align-items: end;
    justify-items: center;
    overflow: visible;
    padding: 0.2rem 0.15rem 0;
  }

  .mag-online-opponents[data-opp-count='1'] {
