---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { authorPhotoSrc } from '../lib/authorPhotos';
import {
  BOOKING_URL,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_TEL,
  CONTACT_WHATSAPP_URL,
} from '../lib/site';
import SpielLogo from './SpielLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const have = ['art', 'games', 'shop'] as const;
const together = ['publishing', 'promotion', 'distribution', 'development'] as const;
const alexPhoto = authorPhotoSrc('alex-lightovy');
---

<section class="opportunity editorial-section" id="partnership" aria-labelledby="opportunity-title">
  <div class="page-shell">
    <header class="opportunity-header reveal">
      <p class="section-label">{t('opportunity.label')}</p>
      <h1 class="section-title" id="opportunity-title">{t('opportunity.title')}</h1>
      <p class="opportunity-lead">{t('opportunity.lead')}</p>
    </header>

    <div class="opportunity-block reveal">
      <h2 class="opportunity-block__title">{t('opportunity.have_title')}</h2>
      <ul class="opportunity-list">
        {have.map((id) => (
          <li>
            <strong>{t(`opportunity.have_${id}_title`)}</strong>
            {' '}
            {t(`opportunity.have_${id}_body`)}
          </li>
        ))}
      </ul>
    </div>

    <div class="opportunity-block reveal">
      <h2 class="opportunity-block__title">{t('opportunity.together_title')}</h2>
      <ul class="opportunity-list">
        {together.map((id) => (
          <li>
            <strong>{t(`opportunity.together_${id}_title`)}</strong>
            {' '}
            {t(`opportunity.together_${id}_body`)}
          </li>
        ))}
      </ul>
    </div>

    <div class="opportunity-block reveal">
      <h2 class="opportunity-block__title">{t('opportunity.aim_title')}</h2>
      <p class="opportunity-aim">{t('opportunity.aim_body')}</p>
    </div>

    <div class="opportunity-spiel reveal" id="spiel">
      <h2 class="opportunity-spiel__title">
        <SpielLogo class="opportunity-spiel__logo" width={220} height={96} />
        <span>{t('opportunity.spiel_title')}</span>
      </h2>
      <p class="opportunity-spiel__date">{t('opportunity.spiel_date')}</p>
      <p class="opportunity-spiel__body">{t('opportunity.spiel_body')}</p>
      <article class="opportunity-person">
        {alexPhoto && (
          <img
            src={alexPhoto}
            alt={t('essen.lightovy.photo_alt')}
            width="205"
            height="205"
            loading="lazy"
            decoding="async"
          />
        )}
        <div>
          <h3>{t('essen.lightovy.name')}</h3>
          <p class="opportunity-person__role">{t('essen.lightovy.role')}</p>
          <p class="opportunity-person__bio">{t('essen.lightovy.bio')}</p>
        </div>
      </article>
      <a
        class="btn btn-accent"
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('opportunity.meet_cta')}
      </a>
    </div>

    <aside class="opportunity-owner reveal">
      <span>{t('opportunity.owner_label')}</span>
      <strong>Alexander Zhilchik</strong>
      <div class="opportunity-contacts">
        <span>{t('opportunity.email_label')}</span>
        <p class="opportunity-contacts__row">
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <span>{t('opportunity.phone_label')}</span>
        <p class="opportunity-contacts__row">
          <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE}</a>
          <span aria-hidden="true">·</span>
          <a href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .opportunity {
    background: var(--paper);
  }

  .opportunity-header {
    max-width: 44rem;
  }

  .opportunity-header .section-title {
    max-width: none;
    margin-top: 1rem;
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    line-height: 1.05;
  }

  .opportunity-lead {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.75;
  }

  .opportunity-block {
    margin-top: clamp(2.75rem, 5vw, 4rem);
    max-width: 44rem;
  }

  .opportunity-block__title {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .opportunity-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .opportunity-list li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .opportunity-list strong {
    color: var(--ink);
    font-weight: 600;
  }

  .opportunity-aim {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .opportunity-spiel {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    border-top: 1px solid var(--line);
    max-width: 44rem;
  }

  .opportunity-spiel__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1rem;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .opportunity-spiel__logo {
    display: block;
    width: auto;
    height: clamp(2.1rem, 3.5vw, 2.85rem);
  }

  .opportunity-spiel__date {
    margin: 0.85rem 0 0;
    color: var(--accent);
    font: 600 0.72rem/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .opportunity-spiel__body {
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .opportunity-person {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin: 1.25rem 0 1.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
  }

  .opportunity-person img {
    flex: 0 0 5.2rem;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 22%;
    filter: saturate(0.88);
  }

  .opportunity-person h3 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .opportunity-person__role {
    margin: 0.35rem 0 0;
    color: var(--accent);
    font: 600 0.58rem/1.45 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .opportunity-person__bio {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .opportunity-owner {
    display: grid;
    gap: 0.35rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.25rem 0;
    border-block: 1px solid var(--line);
    max-width: 44rem;
  }

  .opportunity-owner span {
    color: var(--muted);
    font: 600 0.62rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .opportunity-owner strong {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 400;
  }

  .opportunity-contacts {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .opportunity-contacts > span {
    margin-top: 0.55rem;
    color: var(--muted);
    font: 600 0.62rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .opportunity-contacts > span:first-child {
    margin-top: 0;
  }

  .opportunity-contacts__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.65rem;
    margin: 0;
    font-size: 1.02rem;
  }

  .opportunity-contacts__row a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }

  .opportunity-contacts__row a:hover {
    color: var(--accent-dark);
  }

  .opportunity-contacts__row span[aria-hidden='true'] {
    color: var(--muted);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 720px) {
    .opportunity-header .section-title {
      font-size: clamp(1.85rem, 8vw, 2.8rem);
    }
  }
</style>
