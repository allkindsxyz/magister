---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { authorPhotoSrc } from '../lib/authorPhotos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const authors = [
  {
    key: 'pochitsky',
    image: authorPhotoSrc('vasil-pochitsky'),
    profile: 'https://arthive.com/ru/artists/90797~Vasilij_Vasil%27evich_Pochitskij_dr_Klein',
  },
  {
    key: 'zhilchik',
    image: authorPhotoSrc('alexander-zhilchik'),
    profile: null,
    photoPosition: 'center 10%',
  },
];
---

<section class="authors editorial-section" id="authors" aria-labelledby="authors-title">
  <div class="page-shell">
    <header class="authors-header reveal">
      <p class="section-label">{t('authors.label')}</p>
      <h2 class="section-title" id="authors-title">{t('authors.title')}</h2>
    </header>

    <div class="authors-list">
      {authors.map((author) => (
        <article class="author reveal">
          {author.image && (
            <img
              class="author-photo"
              src={author.image}
              alt={t(`authors.${author.key}.photo_alt`)}
              width="704"
              height="880"
              loading="lazy"
              decoding="async"
              style={'photoPosition' in author && author.photoPosition
                ? `object-position: ${author.photoPosition}`
                : undefined}
            />
          )}
          <h3>{t(`authors.${author.key}.name`)}</h3>
          <p class="author-role">{t(`authors.${author.key}.role`)}</p>
          <p class="author-bio">{t(`authors.${author.key}.bio`)}</p>
          {author.profile && (
            <a class="author-link" href={author.profile} target="_blank" rel="noopener noreferrer">
              {t('authors.pochitsky.link')} ↗
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .authors {
    border-bottom: 1px solid var(--line);
  }

  .authors-header {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .authors-header .section-title {
    max-width: none;
    font-size: clamp(2rem, 4.2vw, 4rem);
    line-height: 0.98;
  }

  .authors-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 4.5vw, 3.5rem);
    padding-top: clamp(2rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .author {
    min-width: 0;
  }

  .author::after {
    content: '';
    display: block;
    clear: both;
  }

  .author-photo {
    float: left;
    width: clamp(6.05rem, 30.8%, 9.35rem);
    margin: 0.15rem 1.1rem 0.5rem 0;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.82);
  }

  .author h3 {
    font-family: var(--display);
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .author-role {
    margin-top: 0.45rem;
    color: var(--accent);
    font: 600 0.58rem/1.45 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .author-bio {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .author-link {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--ink);
    font-size: 0.85rem;
    text-underline-offset: 0.35rem;
  }

  @media (max-width: 680px) {
    .authors-header .section-title {
      font-size: clamp(1.85rem, 9vw, 2.75rem);
    }

    .authors-list {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .author-photo {
      width: clamp(5.5rem, 36%, 8rem);
    }
  }
</style>
