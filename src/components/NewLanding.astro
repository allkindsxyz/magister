---
import MagisterLogo from './MagisterLogo.astro';
import { CONTACT_EMAIL } from '../lib/site';
import { PRICES, SHIPPING, formatPrice } from '../lib/pricing';

const lang = 'en' as const;
const artPrice = formatPrice(PRICES.xl, lang);
const playersPrice = formatPrice(PRICES.standard, lang);
const shipEu = formatPrice(SHIPPING.eu, lang);
const shipUs = formatPrice(SHIPPING.us, lang);
const freeFrom = formatPrice(SHIPPING.free_from, lang);
const joined = Astro.url.searchParams.get('waitlist') === '1';
const waitlistError = Astro.url.searchParams.get('waitlist');
const waitlistFailed = waitlistError === 'email' || waitlistError === 'rate' || waitlistError === 'store';

type Card = { src: string; title: string };

const fan: Card[] = [
  { src: '/cards/queen-hearts.webp', title: 'Aphrodite' },
  { src: '/cards/ace-diamonds.webp', title: 'Diogenes' },
  { src: '/cards/queen-clubs.webp', title: 'The Templar Hunt' },
  { src: '/cards/ace-spades.webp', title: 'Albert Runs at the Speed of a Turtle' },
  { src: '/cards/king-hearts.webp', title: 'Dionysus' },
];
const lead: Card = { src: '/cards/ace-hearts.webp', title: 'Zeus and Mnemosyne' };

const worlds: { id: string; mark: string; name: string; text: string; cards: Card[] }[] = [
  {
    id: 'hearts',
    mark: '♥',
    name: 'Olympian Gods',
    text: 'Zeus and Mnemosyne, Persephone, Aphrodite, Dionysus. Myths of love, power and transformation.',
    cards: [
      { src: '/cards/ace-hearts.webp', title: 'Zeus and Mnemosyne' },
      { src: '/cards/10-hearts.webp', title: 'Persephone' },
      { src: '/cards/queen-hearts.webp', title: 'Aphrodite' },
      { src: '/cards/king-hearts.webp', title: 'Dionysus' },
    ],
  },
  {
    id: 'diamonds',
    mark: '♦',
    name: 'Keepers of Secrets',
    text: 'Initiates, mystics and wanderers, and Diogenes with his lantern. Secrets kept in plain sight.',
    cards: [
      { src: '/cards/ace-diamonds.webp', title: 'Diogenes' },
      { src: '/cards/king-diamonds.webp', title: 'Keeper of the Sacred Temple' },
      { src: '/cards/10-diamonds.webp', title: 'The Barrel-Bearer' },
      { src: '/cards/queen-diamonds.webp', title: 'The Maiden with Pitchers' },
    ],
  },
  {
    id: 'clubs',
    mark: '♣',
    name: 'Templars',
    text: 'The Grand Masters of the Order, from its founder Hugues de Payens to the last, Jacques de Molay.',
    cards: [
      { src: '/cards/ace-clubs.webp', title: 'The Life and Death of the Grand Master' },
      { src: '/cards/queen-clubs.webp', title: 'The Templar Hunt' },
      { src: '/cards/king-clubs.webp', title: 'Keeper of the Skull' },
      { src: '/cards/2-clubs.webp', title: 'Death in Battle' },
    ],
  },
  {
    id: 'spades',
    mark: '♠',
    name: 'Celebrities',
    text: 'Einstein, Bach, Shakespeare, Napoleon, Bruce Lee and more, each travelling with a small creature of their own.',
    cards: [
      { src: '/cards/ace-spades.webp', title: 'Albert Runs at the Speed of a Turtle' },
      { src: '/cards/7-spades.webp', title: 'A Little Night Serenade' },
      { src: '/cards/8-spades.webp', title: 'Shakespeare’s Eighth Sonnet' },
      { src: '/cards/2-spades.webp', title: 'School of the Mantis' },
    ],
  },
];

const suits = [
  { id: 'hearts', mark: '♥', name: 'Olympian Gods' },
  { id: 'diamonds', mark: '♦', name: 'Keepers of Secrets' },
  { id: 'clubs', mark: '♣', name: 'Templars' },
  { id: 'spades', mark: '♠', name: 'Celebrities' },
];

const specs = [
  ['Cards', '54 (52 + 2 jokers)'],
  ['Size', '70 × 120 mm'],
  ['Guide', 'Booklet to every card, in the box'],
  ['Edition', 'First edition of 500'],
  ['Delivery', 'EU and US, 10–14 days'],
  ['Shipping', `EU ${shipEu}, US ${shipUs}. Free from ${freeFrom}.`],
];
---

<div class="nl">
  <header class="nl-bar" id="top">
    <a class="nl-logo" href="#top" aria-label="Magister">
      <MagisterLogo width={200} height={92} level />
    </a>
    <nav class="nl-nav" aria-label="Page">
      <a href="#cards">The Cards</a>
      <a href="#worlds">The Four Worlds</a>
      <a href="#code">The Code</a>
      <a href="#faq">FAQ</a>
    </nav>
    <button class="btn btn-accent nl-buy" type="button" data-buy>Get the Art Edition · {artPrice}</button>
    <button class="nl-burger" type="button" aria-expanded="false" aria-controls="nl-menu">
      <span class="nl-sr">Menu</span>
      <span></span><span></span><span></span>
    </button>
  </header>
  <div class="nl-menu" id="nl-menu" hidden>
    <a href="#cards">The Cards</a>
    <a href="#worlds">The Four Worlds</a>
    <a href="#code">The Code</a>
    <a href="#faq">FAQ</a>
  </div>

  <main id="main-content">
    <section class="nl-hero" aria-labelledby="nl-title">
      <div class="nl-fan" aria-hidden="true">
        {fan.map((card) => (
          <img src={card.src} alt="" width="480" height="688" />
        ))}
        <img class="is-lead" src={lead.src} alt="" width="480" height="688" />
      </div>
      <div class="nl-hero__copy">
        <p class="nl-kicker">Art playing cards</p>
        <h1 id="nl-title">Magister</h1>
        <p class="nl-hero__lead">An art deck of 54 playing cards.</p>
        <p class="nl-hero__deck">Four worlds. 54 stories. One hidden code.</p>
        <p class="nl-hero__body">Every card is an original painting. Its suit and rank are hidden in the picture.</p>
        <div class="nl-hero__actions">
          <button class="btn btn-accent" type="button" data-buy>Get the Art Edition · {artPrice}</button>
          <a class="btn nl-btn-ghost" href="#code">See how the code works</a>
        </div>
        <p class="nl-hero__meta">54 cards · 70 × 120 mm · guide included · ships to the EU and US</p>
      </div>
    </section>

    <section class="nl-section" id="cards" aria-labelledby="nl-glance">
      <div class="page-shell">
        <h2 class="nl-sr" id="nl-glance">In a glance</h2>
        <ul class="nl-glance">
          <li>
            <strong>54 paintings.</strong>
            Each card began as an original painting.
          </li>
          <li>
            <strong>4 worlds.</strong>
            Olympian gods, keepers of secrets, Templars and celebrities.
          </li>
          <li>
            <strong>1 hidden code.</strong>
            Suit and rank live in the picture. The guide shows you where.
          </li>
        </ul>
      </div>
    </section>

    <section class="nl-section nl-section--worlds" id="worlds" aria-labelledby="nl-worlds-title">
      <div class="page-shell">
        <p class="nl-kicker">The deck</p>
        <h2 id="nl-worlds-title">Four worlds. One deck.</h2>
        <p class="nl-lead">Every suit is its own universe, from the myths of Olympus to the founders of the Templar Order.</p>
        <div class="nl-worlds">
          {worlds.map((world) => (
            <article class="nl-world">
              <div class="nl-world__copy">
                <h3><span aria-hidden="true">{world.mark}</span> {world.name}</h3>
                <p>{world.text}</p>
              </div>
              <ul class="nl-strip">
                {world.cards.map((card) => (
                  <li>
                    <figure>
                      <img src={card.src} alt="" width="480" height="688" loading="lazy" decoding="async" />
                      <figcaption>{card.title}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="nl-code" id="code" aria-labelledby="nl-code-title">
      <div class="page-shell nl-code__grid">
        <div>
          <p class="nl-kicker">The code</p>
          <h2 id="nl-code-title">Can you read a card?</h2>
          <p class="nl-lead">Every card hides its suit and rank in the picture. Try one.</p>
          <figure class="nl-code__card">
            <img
              src="/cards/7-clubs.webp"
              alt="A Magister card. Its suit and rank are hidden in the picture."
              width="480"
              height="688"
              data-code-card
            />
            <p class="nl-code__badge" data-code-badge hidden>♣ 7</p>
          </figure>
        </div>
        <form class="nl-quiz" data-code-form>
          <fieldset>
            <legend>1. Which world does it belong to?</legend>
            <div class="nl-choices">
              {suits.map((suit) => (
                <button type="button" data-world={suit.id} aria-pressed="false">
                  <span aria-hidden="true">{suit.mark}</span> {suit.name}
                </button>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend>2. How many figures can you count?</legend>
            <div class="nl-counts">
              {Array.from({ length: 10 }, (_, index) => (
                <button type="button" data-count={index + 1} aria-pressed="false">{index + 1}</button>
              ))}
            </div>
          </fieldset>
          <button class="btn btn-accent" type="submit" data-reveal disabled>Reveal the answer</button>
          <div class="nl-result" data-result hidden tabindex="-1" aria-live="polite"></div>
          <p class="nl-note">
            Nothing to memorise. The guide in the box explains every card, and the Players’ Edition puts the index in the corner for you.
          </p>
          <a class="nl-textlink" href="/en/#play-learn">Train on the whole deck</a>
        </form>
      </div>
    </section>

    <section class="nl-section" id="editions" aria-labelledby="nl-editions-title">
      <div class="page-shell">
        <p class="nl-kicker">The editions</p>
        <h2 id="nl-editions-title">One set of paintings. Two ways to hold them.</h2>
        <div class="nl-editions">
          <article class="nl-edition nl-edition--art">
            <p class="nl-edition__price">{artPrice}</p>
            <h3>Art Edition</h3>
            <p>Suit and rank are hidden in the art. Decode them with the guide.</p>
            <p class="nl-edition__spec">54 cards without indexes · 70 × 120 mm · guide to every card</p>
            <p>For collectors, puzzle lovers and anyone who wants the full Magister experience.</p>
            <p class="nl-edition__honest">
              The Art Edition has no indexes, so it is not a deck for card night. It is a deck to look at, decode and collect.
            </p>
            <button class="btn btn-accent" type="button" data-buy>Get the Art Edition</button>
            <p class="nl-stock">In stock. Delivery to the EU and US in 10–14 days.</p>
          </article>
          <article class="nl-edition" id="players">
            <p class="nl-edition__price">{playersPrice}</p>
            <h3>Players’ Edition <span>coming soon</span></h3>
            <p>The same paintings with suit and rank indexes in the corners. Ready for poker, rummy and solitaire.</p>
            <p class="nl-edition__spec">For playing at the table.</p>
            <p>Not printed yet. Your sign-up tells us whether to print it.</p>
            {joined ? (
              <p class="nl-ok" role="status">You’re on the list. We’ll write when the Players’ Edition is ready to print.</p>
            ) : (
              <form class="nl-wait" action="/api/waitlist" method="post" data-waitlist>
                <p class="nl-hp" aria-hidden="true">
                  <label>Company <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
                </p>
                <label class="nl-sr" for="players-email">Email</label>
                <input id="players-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="Email" maxlength="254" />
                <button class="btn btn-accent" type="submit" data-wait-submit>Notify me</button>
                <label class="nl-check">
                  <input name="twoDeck" type="checkbox" value="on" />
                  I would also want a two-deck set (Art + Players’)
                </label>
                <p class="nl-form-err" role="alert" data-wait-err hidden={!waitlistFailed}>
                  {waitlistFailed
                    ? waitlistError === 'rate'
                      ? 'Too many attempts. Wait a moment and try again.'
                      : waitlistError === 'email'
                        ? 'Enter a valid email.'
                        : 'Something went wrong. Try again.'
                    : ''}
                </p>
              </form>
            )}
          </article>
        </div>
      </div>
    </section>

    <section class="nl-section nl-section--box" id="box" aria-labelledby="nl-box-title">
      <div class="page-shell nl-box">
        <div>
          <p class="nl-kicker">In the box</p>
          <h2 id="nl-box-title">What you get</h2>
          <p class="nl-lead">The Art Edition, as it ships today.</p>
        </div>
        <dl>
          {specs.map(([term, detail]) => (
            <>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <section class="nl-section" id="people" aria-labelledby="nl-people-title">
      <div class="page-shell nl-people">
        <div class="nl-people__pair">
          <figure>
            <img
              src="/media/magister-originals-studio.jpg"
              alt="Original Magister drawings framed on a studio wall, with printed cards on the table."
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
            <figcaption>The original drawings, 2018–2019.</figcaption>
          </figure>
          <figure>
            <img
              src="/cards/ace-hearts.webp"
              alt="Zeus and Mnemosyne, printed as a playing card."
              width="480"
              height="688"
              loading="lazy"
              decoding="async"
            />
            <figcaption>The same work, printed as a card.</figcaption>
          </figure>
        </div>
        <div>
          <p class="nl-kicker">The people behind the deck</p>
          <h2 id="nl-people-title">Every card is a painting.</h2>
          <p>
            Alexander Zhilchik conceived Magister as a world where myth, mystery, history and fame share one deck.
            Vasily Pochitsky (Dr. Klein, 1967–2024) painted it in 2018–2019.
          </p>
        </div>
      </div>
    </section>

    <section class="nl-section nl-section--explore" id="explore" aria-labelledby="nl-explore-title">
      <div class="page-shell">
        <h2 id="nl-explore-title">More ways to explore</h2>
        <ul class="nl-explore">
          <li>
            <a href="/en/#play">
              <strong>Play.</strong>
              Magister, our own card game, or classic favourites.
            </a>
          </li>
          <li>
            <a href="/en/#play-oracle">
              <strong>Ask the Magister.</strong>
              Think of a question, draw a card, get a hint.
            </a>
          </li>
          <li>
            <a href="/en/#play-lore">
              <strong>Test your knowledge.</strong>
              A quiz on the myths and history behind the cards.
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="nl-section" id="faq" aria-labelledby="nl-faq-title">
      <div class="page-shell nl-faq">
        <h2 id="nl-faq-title">FAQ</h2>
        <div class="nl-faq__list">
          <details>
            <summary>Can I really play with it?</summary>
            <p>With the Art Edition, yes, once you know the system, but most people will prefer the Players’ Edition for games. It is coming soon.</p>
          </details>
          <details>
            <summary>Do I need to memorise the cards?</summary>
            <p>Not to enjoy the art. The guide decodes every card, and the trainer on this site helps you learn.</p>
          </details>
          <details>
            <summary>What is the difference between the editions?</summary>
            <p>Same paintings. The Players’ Edition adds suit and rank indexes in the corners. The Art Edition on sale now is the 70 × 120 mm deck.</p>
          </details>
          <details>
            <summary>What is in the box?</summary>
            <p>54 cards, a guide booklet to every card, and the box. Size 70 × 120 mm. First edition of 500.</p>
          </details>
          <details>
            <summary>Is this a tarot or oracle deck?</summary>
            <p>No. It is built like a standard playing deck: four suits, thirteen ranks, two jokers. You can also draw a card for a hint on Ask the Magister.</p>
          </details>
          <details>
            <summary>Shipping?</summary>
            <p>We ship to the EU and the US. Delivery takes 10–14 days. Shipping is {shipEu} in the EU and {shipUs} to the US, free from {freeFrom}.</p>
          </details>
          <details>
            <summary>Who made it?</summary>
            <p>Conceived by Alexander Zhilchik, painted by Vasily Pochitsky (Dr. Klein, 1967–2024).</p>
          </details>
        </div>
      </div>
    </section>

    <section class="nl-final" aria-labelledby="nl-final-title">
      <div class="page-shell">
        <h2 id="nl-final-title">Four worlds are waiting.</h2>
        <div class="nl-hero__actions">
          <button class="btn btn-accent" type="button" data-buy>Get the Art Edition · {artPrice}</button>
          <a class="btn nl-btn-ghost" href="#players">Join the Players’ Edition waitlist</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="nl-foot">
    <div class="page-shell">
      <a class="nl-logo" href="#top" aria-label="Magister">
        <MagisterLogo width={220} height={102} level />
      </a>
      <p>54 cards. 4 worlds. A hidden code.</p>
      <nav aria-label="Footer">
        <a href="#cards">The Cards</a>
        <a href="#worlds">The Four Worlds</a>
        <a href="#code">The Code</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
        <a href="/en/partners/">Partnerships</a>
      </nav>
    </div>
  </footer>
</div>

<script>
  import { addToCart, OPEN_EVENT } from '../lib/cart';

  // Later: Art Edition clicks and purchases, waitlist signups, the two-deck checkbox,
  // interactive completion, FAQ opens, and scroll depth to #editions.

  const WORLD = 'clubs';
  const COUNT = 7;
  const RIGHT = 'You read it. Seven of clubs. The whole deck follows the same system.';
  const MISS =
    'Here is what to look for. This card is clubs, the Templars. Count every figure: two skeletons, the figure between them, the small body in the cloth, the horse and two knights. Seven.';

  document.querySelectorAll<HTMLButtonElement>('[data-buy]').forEach((button) => {
    button.addEventListener('click', () => {
      const result = addToCart({
        sku: 'deck_xl',
        cardId: null,
        cardTitle: null,
        image: '/media/pack.webp',
        color: null,
        size: null,
        message: null,
        lang: 'en',
        previewId: null,
      });
      window.dispatchEvent(
        new CustomEvent(OPEN_EVENT, { detail: { status: result.ok ? 'added' : 'full' } }),
      );
    });
  });

  const burger = document.querySelector<HTMLButtonElement>('.nl-burger');
  const menu = document.querySelector<HTMLElement>('#nl-menu');
  const setMenu = (open: boolean) => {
    if (!burger || !menu) return;
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    menu.hidden = !open;
  };
  burger?.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  const form = document.querySelector<HTMLFormElement>('[data-code-form]');
  const revealBtn = form?.querySelector<HTMLButtonElement>('[data-reveal]');
  const result = form?.querySelector<HTMLElement>('[data-result]');
  const badge = document.querySelector<HTMLElement>('[data-code-badge]');
  const cardImg = document.querySelector<HTMLImageElement>('[data-code-card]');
  let world: string | null = null;
  let count: number | null = null;

  const paint = (button: HTMLButtonElement, group: string, on: boolean) => {
    form?.querySelectorAll<HTMLButtonElement>(group).forEach((item) => {
      item.setAttribute('aria-pressed', item === button && on ? 'true' : 'false');
    });
  };

  form?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-world], button[data-count]');
    if (!button) return;
    if (button.dataset.world) {
      world = button.dataset.world;
      paint(button, '[data-world]', true);
    }
    if (button.dataset.count) {
      count = Number(button.dataset.count);
      paint(button, '[data-count]', true);
    }
    if (revealBtn) revealBtn.disabled = !(world && count);
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!world || !count || !result) return;
    const ok = world === WORLD && count === COUNT;
    result.hidden = false;
    result.classList.toggle('is-right', ok);
    result.textContent = ok ? RIGHT : MISS;
    if (badge) badge.hidden = false;
    if (cardImg) cardImg.alt = 'Return of the Relic, the seven of clubs. Seven figures, Templars.';
    result.focus();
  });

  const wait = document.querySelector<HTMLFormElement>('[data-waitlist]');
  const waitErr = wait?.querySelector<HTMLElement>('[data-wait-err]');
  const waitBtn = wait?.querySelector<HTMLButtonElement>('[data-wait-submit]');
  if (waitErr && waitErr.textContent?.trim()) waitErr.hidden = false;

  wait?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!wait || !waitBtn) return;
    const data = new FormData(wait);
    if (String(data.get('company') || '').trim()) {
      wait.replaceWith(doneNote());
      return;
    }
    waitBtn.disabled = true;
    if (waitErr) waitErr.hidden = true;
    try {
      const response = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          email: String(data.get('email') || ''),
          twoDeck: data.get('twoDeck') === 'on',
          lang: 'en',
        }),
      });
      const payload = (await response.json()) as { ok?: boolean; error?: string };
      if (!response.ok || !payload.ok) {
        showWaitError(payload.error || 'store');
        waitBtn.disabled = false;
        return;
      }
      wait.replaceWith(doneNote());
    } catch {
      showWaitError('store');
      waitBtn.disabled = false;
    }
  });

  function showWaitError(code: string) {
    if (!waitErr) return;
    waitErr.hidden = false;
    waitErr.textContent =
      code === 'rate'
        ? 'Too many attempts. Wait a moment and try again.'
        : code === 'email'
          ? 'Enter a valid email.'
          : 'Something went wrong. Try again.';
  }

  function doneNote(): HTMLParagraphElement {
    const note = document.createElement('p');
    note.className = 'nl-ok';
    note.setAttribute('role', 'status');
    note.textContent = 'You’re on the list. We’ll write when the Players’ Edition is ready to print.';
    return note;
  }
</script>

<style>
  .nl {
    --nl-ink: #14120f;
    --nl-header: 4.25rem;
  }

  .nl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nl-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--nl-header);
    padding: 0.55rem var(--page-pad);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(14px);
  }

  .nl-logo {
    display: flex;
    margin-right: auto;
    --nav-mark-height: 2.15rem;
  }

  .nl-nav {
    display: flex;
    gap: 1.35rem;
  }

  .nl-nav a,
  .nl-menu a,
  .nl-foot a {
    color: var(--ink);
    font: 600 0.72rem/1 var(--sans);
    letter-spacing: 0.08em;
