---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer id="contact">
  <div class="page-shell footer-grid">
    <div class="footer-main">
      <p class="footer-title">Magister Cards</p>
      <p class="footer-closing">{t('footer.closing')}</p>
      <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>

    <div class="footer-bottom">
      <p>© 2026 Magister Cards</p>
      <a href="#deck">{t('footer.back_to_top')} ↑</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding-block: clamp(4rem, 8vw, 8rem) 2rem;
    background: var(--white);
  }

  .footer-grid {
    display: grid;
    gap: 3rem;
  }

  .footer-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 52rem;
  }

  .footer-title {
    font-family: var(--display);
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .footer-closing {
    margin-top: clamp(1.1rem, 2vw, 1.5rem);
    max-width: 38rem;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.6;
  }

  .footer-email {
    display: inline-block;
    width: fit-content;
    margin-top: 1rem;
    color: var(--accent);
    font: 500 0.92rem/1.5 var(--sans);
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .footer-email:hover {
    color: var(--accent-dark);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font: 500 0.62rem/1.4 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-bottom a {
    text-decoration: none;
  }

</style>
