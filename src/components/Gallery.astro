---
import type { Lang } from '../i18n/utils';
import { useTranslations, pickLocalized } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allCards = await getCollection('cards');
const cards = [
  ...allCards.filter((card) => card.data.featured),
  ...allCards.filter((card) => !card.data.featured),
];
const suits = ['spades', 'hearts', 'diamonds', 'clubs'] as const;
const symbols: Record<string, string> = { spades: '♠', hearts: '♥', diamonds: '♦', clubs: '♣' };

const payloads = cards.map((card) => {
  const suit = card.data.suit as (typeof suits)[number];
  return {
    title: pickLocalized(card.data.title, lang),
    description: pickLocalized(card.data.description, lang),
    suit,
    value: card.data.value,
    image: card.data.image,
    suitSymbol: symbols[suit],
    category: pickLocalized(card.data.category, lang),
    worldLine: `${t('gallery.world_label')}: ${t(`worlds.${suit}.name`)}`,
    categoryLine: `${t('gallery.category_label')}: ${pickLocalized(card.data.category, lang)}`,
    metaLine: `${t('gallery.suit_label')}: ${t(`suits.${suit}`)} · ${t('gallery.value_label')}: ${card.data.value}`,
  };
});
---

<div class="gallery" id="fifty-four" aria-labelledby="gallery-title">
  <header class="gallery-header reveal">
    <h3 id="gallery-title">{t('gallery.title')}</h3>
  </header>

  <div class="carousel-outer">
    <div class="carousel-track" id="gallery-track">
      {payloads.map((card, index) => (
        <button
          class="carousel-card"
          type="button"
          data-index={index}
          aria-label={`${t('gallery.open')} ${card.title}`}
        >
          <span class="carousel-card__inner">
            <img
              src={card.image}
              alt=""
              class="carousel-card__img"
              width="920"
              height="1316"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <div class="carousel-card__overlay">
              <div class="carousel-card__overlay-inner">
                <span class="carousel-card__suit">{card.suitSymbol}{card.value}</span>
                <span class="carousel-card__name">{card.title}</span>
                <span class="carousel-card__cat">{card.category}</span>
                <span class="carousel-card__btn">{t('gallery.open_btn')}</span>
              </div>
            </div>
          </span>
        </button>
      ))}
    </div>
    <div class="carousel-fade carousel-fade--left" aria-hidden="true"></div>
    <div class="carousel-fade carousel-fade--right" aria-hidden="true"></div>
  </div>
</div>

<div
  class="lightbox"
  id="card-viewer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lb-title"
  aria-hidden="true"
  inert
  hidden
>
  <div class="lb-shell">
    <button class="lb-close" id="viewer-close" type="button" aria-label={t('gallery.close')}>✕</button>
    <button class="lb-arrow lb-arrow--prev" id="viewer-prev" type="button" aria-label={t('gallery.viewer_previous')}>←</button>

    <div class="lb-inner">
      <div class="lb-img-wrap">
        <div class="lb-card">
          <img id="lb-img" src="" alt="" />
        </div>
      </div>
      <div class="lb-text" aria-live="polite">
        <div class="lb-suit-val" id="lb-suit-val"></div>
        <h2 class="lb-title" id="lb-title"></h2>
        <div class="lb-kicker">
          <p class="lb-kicker-line" id="lb-world-line"></p>
          <p class="lb-kicker-line" id="lb-cat-line"></p>
        </div>
        <div class="lb-divider"></div>
        <p class="lb-body" id="lb-body"></p>
        <p class="lb-meta" id="lb-meta"></p>
      </div>
    </div>

    <button class="lb-arrow lb-arrow--next" id="viewer-next" type="button" aria-label={t('gallery.viewer_next')}>→</button>
  </div>
</div>

<script id="gallery-data" type="application/json" set:html={JSON.stringify(payloads)} />

<style>
  .gallery {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    overflow-x: clip;
    color: var(--ink);
  }

  .gallery-header {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: var(--page-pad);
    text-align: center;
  }

  .gallery-header h3 {
    margin-top: 0;
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .carousel-outer {
    position: relative;
    width: 100%;
    margin-top: 1.75rem;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    padding: 0.5rem var(--page-pad) 1.25rem;
    overflow-x: auto;
    overflow-y: visible;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    touch-action: pan-x pinch-zoom;
    cursor: grab;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .carousel-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5rem;
    pointer-events: none;
    z-index: 2;
  }

  .carousel-fade--left {
    left: 0;
    background: linear-gradient(to right, var(--paper-deep), transparent);
  }

  .carousel-fade--right {
    right: 0;
    background: linear-gradient(to left, var(--paper-deep), transparent);
  }

  .carousel-card {
    display: block;
    flex: 0 0 auto;
    width: clamp(180px, 22vw, 280px);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    scroll-snap-align: start;
    cursor: pointer;
    text-align: left;
  }

  .carousel-card__inner {
    position: relative;
    overflow: hidden;
    border-radius: 0.45rem;
    background: var(--paper);
    box-shadow:
      0 1.25rem 3.75rem rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(23, 23, 20, 0.1);
    transform: translateY(0);
    transition:
      box-shadow 400ms ease,
      transform 400ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .carousel-card:hover .carousel-card__inner,
  .carousel-card:focus .carousel-card__inner,
  .carousel-card:focus-visible .carousel-card__inner {
    box-shadow:
      0 1.9rem 5rem rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(23, 23, 20, 0.16);
    transform: translateY(-8px);
  }

  .carousel-card__img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 7;
    object-fit: contain;
    border-radius: inherit;
    background: var(--paper);
    filter: contrast(1.04) sepia(8%);
    transition: filter 400ms ease;
  }

  .carousel-card:hover .carousel-card__img,
  .carousel-card:focus .carousel-card__img,
  .carousel-card:focus-visible .carousel-card__img {
    filter: contrast(1.08) sepia(3%);
  }

  .carousel-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(
      to top,
      rgba(12, 7, 1, 0.95) 0%,
      rgba(12, 7, 1, 0.5) 45%,
      transparent 75%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .carousel-card:hover .carousel-card__overlay,
  .carousel-card:focus .carousel-card__overlay,
  .carousel-card:focus-visible .carousel-card__overlay {
    opacity: 1;
  }

  .carousel-card__overlay-inner {
    width: 100%;
    padding: 1.5rem 1.2rem 1.4rem;
    color: var(--paper);
    text-align: left;
    transform: translateY(6px);
    transition: transform 350ms ease;
  }

  .carousel-card:hover .carousel-card__overlay-inner,
  .carousel-card:focus .carousel-card__overlay-inner,
  .carousel-card:focus-visible .carousel-card__overlay-inner {
    transform: translateY(0);
  }

  .carousel-card__suit {
    display: block;
    margin-bottom: 0.35rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-family: var(--display);
    font-size: 1.2rem;
    line-height: 1;
  }

  .carousel-card__name {
    display: block;
    margin-bottom: 0.25rem;
    font: 500 0.7rem/1.3 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .carousel-card__cat {
    display: block;
    margin-bottom: 0.5rem;
    color: #c8c3b8;
    font-size: 0.72rem;
    font-style: italic;
    line-height: 1.35;
  }

  .carousel-card__btn {
    display: inline-block;
    padding-bottom: 1px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    color: var(--paper);
    font: 500 0.58rem/1.3 var(--sans);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .lb-arrow,
  .lb-close {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgba(255, 253, 248, 0.28);
    border-radius: 50%;
    background: rgba(20, 16, 12, 0.92);
    color: currentColor;
    cursor: pointer;
    z-index: 2;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
    background: rgba(8, 7, 5, 0.97);
    color: var(--paper);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lb-shell {
    position: relative;
    width: min(100%, 50rem);
    padding: 0 1.75rem;
  }

  .lb-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
  }

  .lb-img-wrap {
    position: relative;
  }

  .lb-card {
    width: clamp(168px, 20vw, 240px);
    overflow: hidden;
    border-radius: 0.45rem;
    background: var(--paper);
    box-shadow:
      0 2.5rem 6.25rem rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 253, 248, 0.18);
  }

  .lb-card img {
    display: block;
    width: 100%;
    object-fit: contain;
  }

  .lb-suit-val {
    margin-bottom: -0.35rem;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
  }

  .lb-suit-val[data-suit='hearts'],
  .lb-suit-val[data-suit='diamonds'] {
    color: #e8a098;
  }

  .lb-suit-val[data-suit='spades'],
  .lb-suit-val[data-suit='clubs'] {
    color: var(--paper);
  }

  .lb-title {
    margin-bottom: 0.65rem;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .lb-kicker {
    margin-bottom: 0.85rem;
  }

  .lb-kicker-line {
    margin: 0;
    color: #aaa69c;
    font: 600 0.62rem/1.7 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .lb-kicker-line + .lb-kicker-line {
    margin-top: 0.35rem;
  }

  .lb-divider {
    width: 2.5rem;
    height: 1px;
    margin-bottom: 1rem;
    background: color-mix(in srgb, var(--paper) 28%, transparent);
  }

  .lb-body {
    max-width: 22rem;
    margin-bottom: 0.85rem;
    color: #e4dfd4;
    font-family: var(--display);
    font-size: 0.88rem;
    font-style: italic;
    line-height: 1.65;
    white-space: pre-line;
  }

  .lb-meta {
    color: #8d887e;
    font: 600 0.58rem/1.5 var(--sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .lb-close {
    position: absolute;
    top: 0;
    right: 1.75rem;
    font-size: 0.85rem;
    transform: translate(50%, -50%);
  }

  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-arrow--prev {
    left: 0;
    transform: translate(-50%, -50%);
  }

  .lb-arrow--next {
    right: 0;
    transform: translate(50%, -50%);
  }

  @media (hover: none) {
    .carousel-card__overlay {
      opacity: 0;
      visibility: hidden;
    }

    .carousel-card:hover .carousel-card__overlay,
    .carousel-card:focus .carousel-card__overlay,
    .carousel-card:focus-visible .carousel-card__overlay {
      opacity: 0;
    }
  }

  @media (max-width: 960px) and (min-width: 761px) {
    .lb-shell {
      width: min(100%, 36rem);
      padding: 0 1.5rem 1.5rem;
      max-height: calc(100dvh - 2rem);
      overflow-y: auto;
    }

    .lb-inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .lb-card {
      width: min(42vw, 260px);
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .lightbox {
      padding: 0;
      align-items: stretch;
      justify-content: stretch;
    }

    .lb-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      max-height: 100dvh;
      padding: 0;
      overflow: hidden;
    }

    .lb-close {
      position: fixed;
      top: max(0.65rem, env(safe-area-inset-top));
      right: max(0.65rem, env(safe-area-inset-right));
      transform: none;
      z-index: 1001;
    }

    .lb-arrow {
      position: fixed;
      top: 50%;
      z-index: 1001;
      width: 2.75rem;
      height: 2.75rem;
    }

    .lb-arrow--prev {
      left: max(0.35rem, env(safe-area-inset-left));
      transform: translateY(-50%);
    }

    .lb-arrow--next {
      right: max(0.35rem, env(safe-area-inset-right));
      transform: translateY(-50%);
    }

    .lb-inner {
      flex: 1;
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 1.1rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding:
        calc(max(0.75rem, env(safe-area-inset-top)) + 2.85rem)
        max(1rem, env(safe-area-inset-right))
        calc(max(1rem, env(safe-area-inset-bottom)) + 0.5rem)
        max(1rem, env(safe-area-inset-left));
    }

    .lb-img-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: min(52dvh, 26rem);
    }

    .lb-card {
      width: min(92vw, 19.5rem);
      max-height: min(52dvh, 26rem);
      margin-inline: auto;
    }

    .lb-card img {
      width: 100%;
      max-height: min(52dvh, 26rem);
      object-fit: contain;
    }

    .lb-body {
      max-width: none;
    }

    .lb-suit-val {
      font-size: clamp(2.25rem, 12vw, 3.25rem);
    }
  }

  @media (max-width: 800px) {
    .carousel-track {
      padding: 0.5rem var(--page-pad) 0.75rem;
      gap: 1rem;
    }

    .carousel-fade {
      width: 2.5rem;
    }

    .carousel-card {
      width: clamp(150px, 55vw, 220px);
    }
  }

</style>

<script>
  interface CardData {
    title: string;
    description: string;
    suit: string;
    value: string;
    image: string;
    suitSymbol: string;
    category: string;
    worldLine: string;
    categoryLine: string;
    metaLine: string;
  }

  const dataNode = document.getElementById('gallery-data');
  const cards: CardData[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  const track = document.getElementById('gallery-track') as HTMLElement | null;

  let dragging = false;
  let moved = false;
  let startX = 0;
  let startScroll = 0;

  track?.addEventListener('mousedown', (event) => {
    dragging = true;
    moved = false;
    startX = event.clientX;
    startScroll = track.scrollLeft;
    track.classList.add('is-dragging');
    event.preventDefault();
  });

  window.addEventListener('mousemove', (event) => {
    if (!dragging || !track) return;
    const delta = event.clientX - startX;
    moved ||= Math.abs(delta) > 5;
    track.scrollLeft = startScroll - delta;
  });

  window.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    track?.classList.remove('is-dragging');
  });

  const viewer = document.getElementById('card-viewer') as HTMLElement | null;
  const close = document.getElementById('viewer-close') as HTMLButtonElement | null;
  const previous = document.getElementById('viewer-prev');
  const next = document.getElementById('viewer-next');
  const image = document.getElementById('lb-img') as HTMLImageElement | null;
  const suitVal = document.getElementById('lb-suit-val');
  const title = document.getElementById('lb-title');
  const worldLine = document.getElementById('lb-world-line');
  const catLine = document.getElementById('lb-cat-line');
  const body = document.getElementById('lb-body');
  const meta = document.getElementById('lb-meta');
  let currentIndex = 0;
  let opener: HTMLElement | null = null;

  function renderCard(index: number) {
    if (!cards.length) return;
    currentIndex = (index + cards.length) % cards.length;
    const card = cards[currentIndex];
    if (image) {
      image.src = card.image;
      image.alt = card.title;
    }
    if (suitVal) {
      suitVal.textContent = `${card.suitSymbol} ${card.value}`;
      suitVal.dataset.suit = card.suit;
    }
    if (title) title.textContent = card.title;
    if (worldLine) worldLine.textContent = card.worldLine;
    if (catLine) catLine.textContent = card.categoryLine;
    if (body) body.textContent = card.description;
    if (meta) meta.textContent = card.metaLine;
  }

  function openViewer(index: number, source: HTMLElement) {
    if (!viewer) return;
    opener = source;
    renderCard(index);
    viewer.hidden = false;
    viewer.removeAttribute('inert');
    viewer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('dialog-open');
    close?.focus();
  }

  function closeViewer() {
    if (!viewer) return;
    viewer.hidden = true;
    viewer.setAttribute('inert', '');
    viewer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('dialog-open');
    opener?.focus();
  }

  track?.querySelectorAll<HTMLElement>('.carousel-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (moved) {
        moved = false;
        return;
      }
      openViewer(Number(card.dataset.index ?? 0), card);
    });
  });

  close?.addEventListener('click', closeViewer);
  previous?.addEventListener('click', () => renderCard(currentIndex - 1));
  next?.addEventListener('click', () => renderCard(currentIndex + 1));
  viewer?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === viewer || target.classList.contains('lb-shell')) closeViewer();
  });

  document.addEventListener('keydown', (event) => {
    if (!viewer || viewer.hidden) return;
    if (event.key === 'Escape') closeViewer();
    if (event.key === 'ArrowLeft') renderCard(currentIndex - 1);
    if (event.key === 'ArrowRight') renderCard(currentIndex + 1);
    if (event.key !== 'Tab') return;

    const focusable = Array.from(viewer.querySelectorAll<HTMLElement>('button:not([disabled])'));
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
