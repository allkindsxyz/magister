---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import DeckSku from '../../components/DeckSku.astro';
import Worlds from '../../components/Worlds.astro';
import Games from '../../components/Games.astro';
import Shop from '../../components/Shop.astro';
import AuthorsCompact from '../../components/AuthorsCompact.astro';
import BuyerFooter from '../../components/BuyerFooter.astro';
import DestinySheet from '../../components/DestinySheet.astro';

const lang = 'be';
---

<Layout
  lang={lang}
  title="Magister Cards — Заказаць калоду"
  description="Арыгінальная міфалагічная калода ў наяўнасці — закажыце калоду, адзенне і арт-прынты. Даследуйце 54 карціны і гуляйце."
>
  <Nav lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <DeckSku lang={lang} />
    <Worlds lang={lang} />
    <Games lang={lang} />
    <Shop lang={lang} />
    <AuthorsCompact lang={lang} />
  </main>
  <BuyerFooter lang={lang} />
  <DestinySheet lang={lang} />
</Layout>
