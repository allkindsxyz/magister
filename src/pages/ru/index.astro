---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Worlds from '../../components/Worlds.astro';
import Games from '../../components/Games.astro';
import Artist from '../../components/Artist.astro';
import NextChapter from '../../components/NextChapter.astro';
import Essen from '../../components/Essen.astro';
import Footer from '../../components/Footer.astro';

const lang = 'ru';
---

<Layout
  lang={lang}
  title="Magister Cards — 54 карты. 4 мира. 1 альтернативная вселенная."
  description="Magister Cards — физическая коллекционная арт-колода с оригинальной альтернативной мифологией."
>
  <Nav lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Worlds lang={lang} />
    <Games lang={lang} />
    <Artist lang={lang} />
    <NextChapter lang={lang} />
    <Essen lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
