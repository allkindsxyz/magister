---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import DeckSku from '../../components/DeckSku.astro';
import Worlds from '../../components/Worlds.astro';
import PlayWays from '../../components/PlayWays.astro';
import Games from '../../components/Games.astro';
import Shop from '../../components/Shop.astro';
import AuthorsCompact from '../../components/AuthorsCompact.astro';
import BuyerFooter from '../../components/BuyerFooter.astro';
import DestinySheet from '../../components/DestinySheet.astro';
import { productCopy } from '../../i18n/merchCopy';

const lang = 'en';
const deckMeta = productCopy.deck[lang];
---

<Layout
  lang={lang}
  title="Magister — Art Playing Cards by Dr. Klein"
  description={deckMeta.meta_description}
>
  <Nav lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Worlds lang={lang} />
    <PlayWays lang={lang} />
    <Games lang={lang} />
    <AuthorsCompact lang={lang} />
    <DeckSku lang={lang} />
    <Shop lang={lang} />
  </main>
  <BuyerFooter lang={lang} />
  <DestinySheet lang={lang} />
</Layout>
